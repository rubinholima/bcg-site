{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AcmRequestManagedTagDns",
      "Effect": "Allow",
      "Action": "acm:RequestCertificate",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1",
          "aws:RequestTag/cup360-managed": "public-domain-site",
          "acm:ValidationMethod": "DNS"
        },
        "ForAllValues:StringEquals": {
          "aws:TagKeys": ["cup360-managed", "cup360-tenant", "cup360-public-domain-id"]
        }
      }
    },
    {
      "Sid": "AcmReadTagged",
      "Effect": "Allow",
      "Action": ["acm:DescribeCertificate", "acm:ListTagsForCertificate"],
      "Resource": "arn:aws:acm:us-east-1:887366284369:certificate/*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/cup360-managed": "public-domain-site"
        }
      }
    },
    {
      "Sid": "AcmTagNewCertificates",
      "Effect": "Allow",
      "Action": "acm:AddTagsToCertificate",
      "Resource": "arn:aws:acm:us-east-1:887366284369:certificate/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/cup360-managed": "public-domain-site"
        }
      }
    },
    {
      "Sid": "CloudFrontCreateManaged",
      "Effect": "Allow",
      "Action": ["cloudfront:CreateDistribution", "cloudfront:CreateFunction", "cloudfront:TagResource"],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/cup360-managed": "public-domain-site"
        }
      }
    },
    {
      "Sid": "CloudFrontMutateTaggedOnly",
      "Effect": "Allow",
      "Action": [
        "cloudfront:GetDistribution",
        "cloudfront:GetDistributionConfig",
        "cloudfront:UpdateDistribution",
        "cloudfront:ListTagsForResource",
        "cloudfront:DescribeFunction",
        "cloudfront:UpdateFunction",
        "cloudfront:PublishFunction"
      ],
      "Resource": [
        "arn:aws:cloudfront::887366284369:distribution/*",
        "arn:aws:cloudfront::887366284369:function/cup360-site-*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/cup360-managed": "public-domain-site"
        }
      }
    },
    {
      "Sid": "DenyLegacyDistributions",
      "Effect": "Deny",
      "Action": ["cloudfront:UpdateDistribution", "cloudfront:TagResource"],
      "Resource": [
        "arn:aws:cloudfront::887366284369:distribution/EQ7G08XI2IC8C",
        "arn:aws:cloudfront::887366284369:distribution/E1NBA89C9PALRU",
        "arn:aws:cloudfront::887366284369:distribution/E25Z46F65I1QT"
      ]
    },
    {
      "Sid": "Route53Discovery",
      "Effect": "Allow",
      "Action": ["route53:ListHostedZonesByName", "route53:GetChange"],
      "Resource": "*"
    },
    {
      "Sid": "Route53ListInAuthorizedZone",
      "Effect": "Allow",
      "Action": "route53:ListResourceRecordSets",
      "Resource": "arn:aws:route53:::hostedzone/Z0293263107R5329WZZM8"
    },
    {
      "Sid": "Route53ChangeCup360Records",
      "Effect": "Allow",
      "Action": "route53:ChangeResourceRecordSets",
      "Resource": "arn:aws:route53:::hostedzone/Z0293263107R5329WZZM8",
      "Condition": {
        "ForAllValues:StringEquals": {
          "route53:ChangeResourceRecordSetsRecordTypes": ["A", "CNAME", "TXT"],
          "route53:ChangeResourceRecordSetsActions": ["UPSERT", "DELETE"]
        }
      }
    },
    {
      "Sid": "DenyRoute53OutsideAllowlist",
      "Effect": "Deny",
      "Action": "route53:ChangeResourceRecordSets",
      "NotResource": "arn:aws:route53:::hostedzone/Z0293263107R5329WZZM8"
    },
    {
      "Sid": "DenyMailRecordTypes",
      "Effect": "Deny",
      "Action": "route53:ChangeResourceRecordSets",
      "Resource": "arn:aws:route53:::hostedzone/Z0293263107R5329WZZM8",
      "Condition": {
        "ForAllValues:StringEquals": {
          "route53:ChangeResourceRecordSetsRecordTypes": ["MX", "NS", "SOA", "SRV"]
        }
      }
    },
    {
      "Sid": "DenyLegacyAcmTagging",
      "Effect": "Deny",
      "Action": "acm:AddTagsToCertificate",
      "Resource": [
        "arn:aws:acm:us-east-1:887366284369:certificate/a0820055-641b-4196-bd32-8b0d581d184c",
        "arn:aws:acm:us-east-1:887366284369:certificate/4926d514-3018-474b-a104-ce14500169bd",
        "arn:aws:acm:us-east-1:887366284369:certificate/222019de-78ff-4088-b69e-2dda1af12c9a",
        "arn:aws:acm:us-east-1:887366284369:certificate/06a9f9f3-be5c-40a9-a5d8-7d85763005f9"
      ]
    }
  ]
}
