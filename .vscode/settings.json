{
  "npm.packageManager": "pnpm",
  "npm.autoDetect": "off",
  "task.autoDetect": "off",
  "files.exclude": {
    "**/.git": true,
    "**/.DS_Store": true,
    "**/node_modules": true,
    "**/dist": true,
    "**/build": true,
    "**/.vite": true,
    "**/.next": true,
    "**/*.tsbuildinfo": true,
    "**/_tmp*": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/dist": true,
    "**/build": true,
    "**/.vite": true,
    "**/coverage": true,
    "**/.next": true,
    "**/_tmp*": true
  },
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/node_modules/**": true,
    "**/dist/**": true,
    "**/build/**": true,
    "**/.vite/**": true,
    "**/.next/**": true,
    "**/coverage/**": true,
    "**/_tmp*": true
  },
  "editor.largeFileOptimizations": true
}
