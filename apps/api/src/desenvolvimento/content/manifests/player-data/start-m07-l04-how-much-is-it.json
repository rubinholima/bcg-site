      ]},
      { "id": "l04-learn-07", "type": "mistake", "titlePt": "Erro comum de brasileiros", "wrongEn": "How much costs this?", "rightEn": "How much is this? / How much does this cost?", "explanationPt": "How much costs não é natural. Use How much is it? ou How much does it cost?" },
      { "id": "l04-learn-08", "type": "review", "titleEn": "Quick review", "titlePt": "Revisão rápida", "items": [
        { "en": "How much is it?", "pt": "quanto custa (1 item)" }, { "en": "How much are these?", "pt": "quanto custam" },
        { "en": "It's ten dollars.", "pt": "resposta de preço" }, { "en": "I'll take it.", "pt": "vou comprar" }
      ]}
