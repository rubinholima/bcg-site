        "examples": [
          { "en": "Do you have any siblings?", "pt": "tem irmãos?" },
          { "en": "Who is that?", "pt": "quem é?" },
          { "en": "How many brothers and sisters do you have?", "pt": "quantos irmãos?" },
          { "en": "Where does your family live?", "pt": "onde mora sua família?" }
        ]
      },
