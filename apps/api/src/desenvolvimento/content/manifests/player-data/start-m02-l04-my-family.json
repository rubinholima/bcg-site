  "mission": {
    "headlineEn": "You can talk about your family in English.",
    "headlinePt": "Você consegue falar da sua família em inglês.",
    "bodyPt": "",
    "canDo": [
      "This is my mother.",
      "This is my father.",
      "I have a brother and a sister.",
      "Do you have any siblings?"
    ],
    "production": {
      "introPt": "Jamie viu uma foto no seu celular. Apresente dois membros da família em inglês — use sua família real ou nomes de prática.",
      "prompts": [
        { "speaker": "Jamie", "questionEn": "Who is that?" },
        { "speaker": "Jamie", "questionEn": "Do you have any siblings?" }
      ],
      "fields": [
        { "id": "introPerson1", "labelPt": "Apresentar pessoa 1", "prefixEn": "This is my", "placeholderEn": "mother. Her name is Ana." },
        { "id": "introPerson2", "labelPt": "Apresentar pessoa 2", "prefixEn": "This is my", "placeholderEn": "brother. He's 25." },
        { "id": "siblings", "labelPt": "Irmãos", "prefixEn": "", "placeholderEn": "I have one brother and one sister." }
      ],
      "exampleEn": "Who is that? — This is my mother. Her name is Ana. — Do you have any siblings? — I have one brother and one sister."
    }
  },
  "stepScreens": {
    "context": [
      {
        "id": "l04-ctx-01",
        "type": "intro",
        "titleEn": "My family",
        "titlePt": "Minha família",
        "bodyPt": "Conversas sobre família surgem no trabalho — happy hour, almoço, foto no celular, formulário de emergência. Nesta lição: palavras básicas e This is my... para apresentar quem você ama."
      },
      {
        "id": "l04-ctx-02",
        "type": "scenario",
        "settingEn": "Office lunch · Casual conversation",
        "scenarioPt": "Você mostra uma foto recente no celular. Jamie, colega americana, olha curiosa e pergunta sobre as pessoas."
      },
      {
        "id": "l04-ctx-03",
        "type": "dialogue_choice",
        "speaker": "Jamie",
        "promptEn": "Who is that?",
        "promptPt": "Jamie aponta para uma pessoa na foto. Como apresentar sua mãe?",
        "options": [
          { "labelEn": "This is my mother.", "correct": true, "feedbackPt": "This is my + parentesco — padrão para apresentar." },
          { "labelEn": "I have mother.", "correct": false, "feedbackPt": "Gramaticalmente incorreto — use This is my ou I have a mother." },
          { "labelEn": "She is mother my.", "correct": false, "feedbackPt": "Ordem das palavras errada." }
        ]
      },
      {
        "id": "l04-ctx-04",
        "type": "dialogue_choice",
        "speaker": "Jamie",
        "promptEn": "And who is this guy?",
        "promptPt": "Jamie pergunta sobre um homem na foto — seu pai.",
        "options": [
          { "labelEn": "This is my father.", "correct": true, "feedbackPt": "Apresentação clara com father." },
          { "labelEn": "This is my brother.", "correct": false, "feedbackPt": "Brother = irmão — contexto da foto indica pai." },
          { "labelEn": "My father is this.", "correct": false, "feedbackPt": "Ordem invertida — não soa natural." }
        ]
      },
      {
        "id": "l04-ctx-05",
        "type": "dialogue_choice",
        "speaker": "Jamie",
        "promptEn": "Do you have any siblings?",
        "promptPt": "Jamie pergunta sobre irmãos. Você tem um irmão e uma irmã:",
        "options": [
          { "labelEn": "I have one brother and one sister.", "correct": true, "feedbackPt": "Resposta completa e natural." },
          { "labelEn": "I have siblings one.", "correct": false, "feedbackPt": "Ordem incorreta." },
          { "labelEn": "No, I don't have family.", "correct": false, "feedbackPt": "Contradiz o cenário — você tem irmãos." }
        ]
      },
      {
        "id": "l04-ctx-06",
        "type": "dialogue_choice",
        "speaker": "You",
        "promptEn": "This is my sister.",
        "promptPt": "Você quer apresentar sua irmã na foto. Qual frase usar?",
