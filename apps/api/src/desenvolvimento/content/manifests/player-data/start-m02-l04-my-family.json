          { "labelEn": "This is my sister.", "correct": true, "feedbackPt": "Padrão fixo — This is my + parentesco." },
          { "labelEn": "This is sister my.", "correct": false, "feedbackPt": "My vem antes do substantivo." },
          { "labelEn": "I am my sister.", "correct": false, "feedbackPt": "Você não É sua irmã — você a apresenta." }
        ]
      }
