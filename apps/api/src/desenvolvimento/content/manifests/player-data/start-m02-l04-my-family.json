        "type": "phrase_examples",
        "titleEn": "This is my...",
        "titlePt": "Este(a) é meu/minha...",
        "introPt": "Padrão para apresentar alguém — foto, videochamada ou pessoa presente.",
        "examples": [
          { "en": "This is my mother.", "pt": "minha mãe" },
          { "en": "This is my brother.", "pt": "meu irmão" },
