        "type": "phrase_examples",
        "titleEn": "Yesterday I...",
        "titlePt": "Ontem eu...",
        "introPt": "Para dizer o que fez ontem, use Yesterday I + verbo simples. Conjunto limitado nesta fase:",
        "examples": [
          { "en": "Yesterday I stayed home.", "pt": "fiquei em casa" },
          { "en": "Yesterday I worked.", "pt": "trabalhei" },
          { "en": "Yesterday I rested.", "pt": "descansei" },
          { "en": "Yesterday I went out.", "pt": "saí" }
        ]
      },
      {
        "id": "m09l01-learn-06",
        "type": "language_focus",
        "titleEn": "Functional past — not grammar class",
        "titlePt": "Passado funcional — não aula de gramática",
        "items": [
          { "formalEn": "Yesterday was Sunday.", "naturalEn": "Yesterday was Sunday. It was good!", "notePt": "Frases prontas primeiro — você não precisa dominar Past Simple agora." },
          { "formalEn": "Today is Monday.", "naturalEn": "Good morning! Today is Monday.", "notePt": "Nomear o dia ajuda a contextualizar a conversa." }
        ],
        "tipPt": "Memorize pares: Today is X → Yesterday was Y. Depois adicione Yesterday I + atividade."
      },
