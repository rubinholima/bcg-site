  "mission": {
    "headlineEn": "Talk about yesterday.",
    "headlinePt": "Fale sobre ontem.",
    "bodyPt": "",
    "canDo": [
      "Yesterday was Sunday.",
      "Today is Monday.",
      "Yesterday I stayed home.",
      "Yesterday I worked."
    ],
    "production": {
      "introPt": "Jamie quer saber sobre ontem. Diga qual dia era ontem e uma coisa simples que você fez.",
      "prompts": [
        { "speaker": "Jamie", "questionEn": "How was yesterday?" }
      ],
      "fields": [
        { "id": "today", "labelPt": "Hoje é...", "prefixEn": "Today is", "placeholderEn": "Monday." },
        { "id": "yesterday", "labelPt": "Ontem era...", "prefixEn": "Yesterday was", "placeholderEn": "Sunday." },
        { "id": "activity", "labelPt": "Ontem eu...", "prefixEn": "Yesterday I", "placeholderEn": "stayed home." }
      ],
      "exampleEn": "Today is Monday. Yesterday was Sunday. Yesterday I stayed home."
    }
  },
  "stepScreens": {
