      {
        "id": "m09l01-ctx-01",
        "type": "intro",
        "titleEn": "Yesterday",
        "titlePt": "Ontem",
        "bodyPt": "Para falar do passado recente, comece pelo básico: yesterday (ontem) e frases fixas que nomeiam o dia — Today is... e Yesterday was..."
      },
      {
        "id": "m09l01-ctx-02",
        "type": "scenario",
        "settingEn": "Office kitchen · Monday morning",
        "scenarioPt": "Você encontra Jamie na copa. Ela comenta o fim de semana e quer saber como foi ontem."
      },
      {
        "id": "m09l01-ctx-03",
        "type": "dialogue_choice",
        "speaker": "Jamie",
        "promptEn": "Good morning! Today is Monday. How was yesterday?",
        "promptPt": "Jamie nomeia hoje e pergunta sobre ontem. Como responder?",
        "options": [
          { "labelEn": "Yesterday was Sunday. It was good!", "correct": true, "feedbackPt": "Yesterday was + dia — frase fixa e natural." },
          { "labelEn": "Tomorrow is Tuesday.", "correct": false, "feedbackPt": "Tomorrow é futuro — a pergunta foi sobre ontem." },
          { "labelEn": "I am Monday.", "correct": false, "feedbackPt": "Dia da semana não combina com I am." }
        ]
      },
      {
        "id": "m09l01-ctx-04",
        "type": "dialogue_choice",
        "speaker": "Jamie",
        "promptEn": "What did you do yesterday?",
        "promptPt": "Jamie quer uma atividade de ontem. Resposta simples:",
        "options": [
          { "labelEn": "Yesterday I stayed home.", "correct": true, "feedbackPt": "Yesterday I + verbo — padrão funcional para iniciantes." },
          { "labelEn": "Yesterday I am home.", "correct": false, "feedbackPt": "Passado pede stayed, não am." },
          { "labelEn": "Yesterday is home.", "correct": false, "feedbackPt": "Yesterday não combina com is neste contexto." }
        ]
      },
      {
        "id": "m09l01-ctx-05",
        "type": "dialogue_choice",
        "speaker": "Jamie",
        "promptEn": "Nice! See you later!",
