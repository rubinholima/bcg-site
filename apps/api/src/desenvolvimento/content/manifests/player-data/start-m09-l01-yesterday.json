        "options": [
          { "labelEn": "See you later!", "correct": true, "feedbackPt": "Despedida natural." },
          { "labelEn": "Yesterday was good.", "correct": false, "feedbackPt": "Não responde à despedida." },
          { "labelEn": "Today is Monday.", "correct": false, "feedbackPt": "Repete informação — Jamie já sabe." }
        ]
      }
