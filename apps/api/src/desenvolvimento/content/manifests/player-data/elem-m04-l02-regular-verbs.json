  "context": { "scenarioPt": "Jamie pede detalhes do fim de semana — você usa verbos regulares no passado.", "dialogue": [] },
  "learn": { "introPt": "", "phrases": [] },
  "imitate": { "introPt": "Leia em voz alta e repita cada frase.", "phrases": [] },
