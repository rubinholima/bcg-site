      "introPt": "Conte seus interesses, pergunte sobre Alex e responda quando ele devolver a pergunta.",
      "prompts": [
        {
          "speaker": "Alex",
          "questionEn": "What are you into these days?"
        },
        {
          "speaker": "Alex",
          "questionEn": "Do you like hiking?"
        }
      ],
      "fields": [
        {
          "id": "into",
          "labelPt": "Seus interesses",
          "prefixEn": "I'm into",
          "placeholderEn": "soccer and cooking."
        },
