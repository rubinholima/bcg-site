          "labelPt": "Perguntar sobre Alex",
          "prefixEn": "",
          "placeholderEn": "Do you like sports?"
        },
        {
          "id": "react",
          "labelPt": "Reagir ao hobby dele",
          "prefixEn": "",
          "placeholderEn": "Oh, really? Tell me more."
