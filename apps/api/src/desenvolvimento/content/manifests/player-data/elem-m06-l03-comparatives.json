      { "id": "em06l03-learn-05", "type": "language_focus", "titleEn": "Than — not then or that", "titlePt": "Than — não then ou that", "items": [
        { "formalEn": "bigger than", "naturalEn": "Always than in comparisons.", "notePt": "Than = do que. Then = então." },
        { "formalEn": "more expensive than", "naturalEn": "more + adjective + than", "notePt": "Ordem fixa." },
        { "formalEn": "The suburbs are cheaper.", "naturalEn": "Comparative without than = general.", "notePt": "Com than = compara dois things." }
