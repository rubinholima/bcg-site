    "mission": [{ "id": "em06l03-miss-01", "type": "mission_intro", "headlineEn": "Compare two areas.", "headlinePt": "Compare duas áreas.", "bodyPt": "Três comparativos diferentes.", "prompts": [{ "speaker": "Jamie", "questionEn": "Downtown or suburbs?" }] }]
