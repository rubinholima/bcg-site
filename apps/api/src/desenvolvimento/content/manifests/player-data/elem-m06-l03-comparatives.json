  "mission": {
    "headlineEn": "Compare two neighborhoods.",
    "headlinePt": "Compare dois bairros.",
    "bodyPt": "",
    "canDo": [
      "Downtown is more expensive than the suburbs.",
      "The suburbs are quieter than downtown.",
      "My apartment is bigger than yours.",
      "This area is better for families.",
      "The rent here is cheaper than near the stadium."
    ],
    "production": {
      "introPt": "Compare dois bairros ou opções usando pelo menos três comparativos diferentes.",
      "prompts": [{ "speaker": "Jamie", "questionEn": "Which neighborhood would you recommend — downtown or the suburbs?" }],
      "fields": [
        { "id": "compare1", "labelPt": "Comparativo 1", "prefixEn": "", "placeholderEn": "Downtown is more expensive than the suburbs." },
        { "id": "compare2", "labelPt": "Comparativo 2", "prefixEn": "", "placeholderEn": "The suburbs are quieter and safer." },
        { "id": "compare3", "labelPt": "Comparativo 3", "prefixEn": "", "placeholderEn": "But downtown is better for nightlife and restaurants." }
      ],
      "exampleEn": "Downtown is more expensive than the suburbs. The suburbs are quieter. But downtown is better for restaurants and nightlife."
    }
  },
  "stepScreens": {
    "context": [
      { "id": "em06l03-ctx-01", "type": "intro", "titleEn": "Comparatives", "titlePt": "Comparativos", "bodyPt": "Bigger than, more expensive than — comparar opções é essencial ao escolher onde morar, comprar ou trabalhar." },
      { "id": "em06l03-ctx-02", "type": "scenario", "settingEn": "Office · Housing discussion", "scenarioPt": "Colega vai se mudar e pede opinião sobre bairros." },
