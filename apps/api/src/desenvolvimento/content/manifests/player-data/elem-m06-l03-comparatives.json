    "learn": [
      { "id": "em06l03-learn-01", "type": "phrase_examples", "titleEn": "Short adjectives — -er than", "titlePt": "Adjetivos curtos — -er than", "introPt": "1 sílaba ou 2 sílabas terminadas em -y:", "examples": [
        { "en": "big → bigger than", "pt": "maior que" },
        { "en": "small → smaller than", "pt": "menor que" },
        { "en": "cheap → cheaper than", "pt": "mais barato que" },
        { "en": "quiet → quieter than", "pt": "mais tranquilo que" }
      ]},
      { "id": "em06l03-learn-02", "type": "phrase_examples", "titleEn": "Long adjectives — more ... than", "titlePt": "Adjetivos longos — more ... than", "introPt": "2+ sílabas (exceto -y):", "examples": [
        { "en": "expensive → more expensive than", "pt": "mais caro que" },
        { "en": "convenient → more convenient than", "pt": "mais conveniente" },
        { "en": "comfortable → more comfortable than", "pt": "mais confortável" },
        { "en": "crowded → more crowded than", "pt": "mais lotado" }
      ]},
      { "id": "em06l03-learn-03", "type": "phrase_examples", "titleEn": "Irregular comparatives", "titlePt": "Comparativos irregulares", "introPt": "Memorize — não seguem regra:", "examples": [
        { "en": "good → better than", "pt": "melhor que" },
        { "en": "bad → worse than", "pt": "pior que" },
        { "en": "far → farther/further than", "pt": "mais longe que" },
        { "en": "little → less than", "pt": "menos que" }
      ]},
      { "id": "em06l03-learn-04", "type": "comparison", "titleEn": "-er vs more", "titlePt": "-er vs more", "left": {
