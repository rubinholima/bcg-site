      {
        "id": "m04l05-learn-05",
        "type": "language_focus",
        "titleEn": "DO auxiliary rule",
        "titlePt": "Regra do auxiliar DO",
        "items": [
          { "formalEn": "You work every day?", "naturalEn": "Do you work every day?", "notePt": "Perguntas em inglês PRECISAM de Do/Does — não basta inverter como em português." },
          { "formalEn": "Does he trains?", "naturalEn": "Does he train?", "notePt": "Após Does, verbo na base — sem -s." }
        ],
        "tipPt": "Fórmula: Do/Does + sujeito + verbo base?"
      },
