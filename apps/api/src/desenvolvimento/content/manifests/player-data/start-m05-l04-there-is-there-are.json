        { "labelEn": "One cafeteria (singular).", "correct": true, "feedbackPt": "There is + singular." },
        { "labelEn": "Many cafeterias (plural).", "correct": false, "feedbackPt": "Plural usa There are." },
        { "labelEn": "No cafeteria.", "correct": false, "feedbackPt": "A frase afirma que existe uma." }
      ]},
      { "id": "m05l04-ctx-04", "type": "dialogue_choice", "speaker": "Alex", "promptEn": "There are two gyms in the building.", "promptPt": "There are combina com:", "options": [
        { "labelEn": "Two gyms (plural).", "correct": true, "feedbackPt": "There are + plural." },
        { "labelEn": "One gym only.", "correct": false, "feedbackPt": "Singular usa There is." },
        { "labelEn": "Zero gyms.", "correct": false, "feedbackPt": "Two indica plural." }
      ]},
