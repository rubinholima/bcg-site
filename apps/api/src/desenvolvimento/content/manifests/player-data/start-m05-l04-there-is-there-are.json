        { "en": "There are many offices.", "pt": "muitos escritórios" },
        { "en": "There are some chairs here.", "pt": "algumas cadeiras" }
      ]},
      { "id": "m05l04-learn-03", "type": "phrase_examples", "titleEn": "a / an", "titlePt": "a / an", "introPt": "A antes de consoante; an antes de vogal — com There is.", "examples": [
        { "en": "There is a cafeteria.", "pt": "c começa com consoante" },
        { "en": "There is an office.", "pt": "o começa com vogal" },
        { "en": "There is a gym.", "pt": "a + gym" },
        { "en": "There is an elevator.", "pt": "an + elevator" }
      ]},
      { "id": "m05l04-learn-04", "type": "phrase_examples", "titleEn": "some", "titlePt": "some — alguns/as", "introPt": "Some com plural ou quantidade indefinida — There are some...", "examples": [
        { "en": "There are some desks.", "pt": "algumas mesas" },
        { "en": "There are some meeting rooms.", "pt": "algumas salas" },
        { "en": "There is some coffee.", "pt": "um pouco de café" },
        { "en": "There are some people waiting.", "pt": "algumas pessoas" }
      ]},
      { "id": "m05l04-learn-05", "type": "phrase_examples", "titleEn": "There isn't / There aren't", "titlePt": "Negativo", "introPt": "Negar existência — isn't (singular) ou aren't (plural).", "examples": [
        { "en": "There isn't a pool.", "pt": "não tem piscina" },
        { "en": "There aren't any elevators.", "pt": "não tem elevadores" },
        { "en": "There isn't an cafeteria.", "pt": "ERRADO — use a cafeteria" },
        { "en": "There aren't many parking spots.", "pt": "poucas vagas" }
      ]},
      { "id": "m05l04-learn-06", "type": "phrase_examples", "titleEn": "Is there / Are there?", "titlePt": "Perguntas", "introPt": "Inverter para perguntar — Is there...? / Are there...?", "examples": [
        { "en": "Is there a cafeteria?", "pt": "tem cafeteria?" },
        { "en": "Are there any restrooms?", "pt": "tem banheiros?" },
        { "en": "Is there an ATM nearby?", "pt": "caixa eletrônico?" },
        { "en": "Are there two entrances?", "pt": "duas entradas?" }
      ]},
      { "id": "m05l04-learn-07", "type": "mistake", "titlePt": "Erro comum de brasileiros", "wrongEn": "There are a cafeteria.", "rightEn": "There is a cafeteria.", "explanationPt": "A cafeteria = singular → There is. There are só com plural (two cafeterias, some cafeterias)." },
      { "id": "m05l04-learn-08", "type": "review", "titleEn": "Quick review", "titlePt": "Revisão rápida", "items": [
        { "en": "There is a...", "pt": "singular" },
        { "en": "There are two...", "pt": "plural" },
        { "en": "a / an", "pt": "artigo" },
        { "en": "some", "pt": "alguns" },
        { "en": "There isn't...", "pt": "negativo singular" },
        { "en": "Are there any...?", "pt": "pergunta plural" },
        { "en": "describe facilities", "pt": "descrever instalações" }
      ]}
    ],
    "imitate": [{ "id": "m05l04-imit-01", "type": "read_repeat", "titleEn": "Read & Repeat", "titlePt": "Leia e repita", "introPt": "Adapte às instalações do seu trabalho.", "phrases": [
      { "en": "There is a cafeteria." }, { "en": "There is an office upstairs." }, { "en": "There are two gyms." }, { "en": "There are some meeting rooms." }, { "en": "Is there a parking lot?" }, { "en": "There isn't a pool." }, { "en": "Are there any restrooms?" }, { "en": "There are three floors." }
    ], "dialogueEn": "What's in this building? — There is a cafeteria on the first floor. There are two gyms. There isn't a pool, but there are some meeting rooms upstairs." }],
    "mission": [{ "id": "m05l04-miss-01", "type": "mission_intro", "headlineEn": "Describe the building.", "headlinePt": "Descreva o prédio.", "bodyPt": "Use There is e There are.", "prompts": [{ "speaker": "Visitor", "questionEn": "What's in this building?" }] }]
  },
