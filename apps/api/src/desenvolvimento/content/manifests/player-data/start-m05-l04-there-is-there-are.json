        { "en": "There is a gym near the field.", "pt": "tem uma academia" }
      ]},
      { "id": "m05l04-learn-02", "type": "phrase_examples", "titleEn": "There are (plural)", "titlePt": "There are — plural", "introPt": "Use There are + duas ou mais coisas.", "examples": [
        { "en": "There are two gyms.", "pt": "existem duas academias" },
