    { "id": "m05l04-prac-05", "type": "dialogue_complete", "promptPt": "Visitante pergunta sobre piscina — não tem:", "speaker": "You", "contextEn": "Visitor: Is there a pool?", "options": [
      { "labelEn": "No, there isn't a pool.", "correct": true, "feedbackPt": "Negativo singular correto." },
