    "learn": [
      { "id": "m05l04-learn-01", "type": "phrase_examples", "titleEn": "There is (singular)", "titlePt": "There is — singular", "introPt": "Use There is + uma coisa — one item.", "examples": [
        { "en": "There is a cafeteria.", "pt": "tem uma cafeteria" },
