  "mission": {
    "headlineEn": "Describe what's in a place.",
    "headlinePt": "Descreva o que tem em um lugar.",
    "bodyPt": "",
    "canDo": ["There is a cafeteria.", "There are two gyms.", "There isn't a pool.", "Are there any offices?", "a / an / some", "singular vs plural", "describe facilities"],
    "production": {
      "introPt": "Descreva o que existe no prédio do clube — uma coisa no singular e uma no plural.",
      "prompts": [{ "speaker": "Visitor", "questionEn": "What's in this building?" }],
      "fields": [
        { "id": "singular", "labelPt": "Singular (There is...)", "prefixEn": "There is", "placeholderEn": "a cafeteria on the first floor." },
        { "id": "plural", "labelPt": "Plural (There are...)", "prefixEn": "There are", "placeholderEn": "three meeting rooms upstairs." }
      ],
      "exampleEn": "There is a cafeteria on the first floor. There are three meeting rooms upstairs."
    }
  },
  "stepScreens": {
    "context": [
      { "id": "m05l04-ctx-01", "type": "intro", "titleEn": "There is / There are", "titlePt": "Tem / Existem", "bodyPt": "Para dizer o que existe em um lugar — uma sala, várias salas, equipamentos — use There is (singular) e There are (plural)." },
      { "id": "m05l04-ctx-02", "type": "scenario", "settingEn": "Club facility tour · Building walkthrough", "scenarioPt": "Alex guia um visitante pelo prédio administrativo e descreve as instalações." },
