      {
        "id": "em09l03-learn-cmp",
        "type": "comparison",
        "titleEn": "Can vs Could",
        "titlePt": "Can vs Could",
        "left": {
          "labelEn": "CAN · teammates, quick asks",
          "exampleEn": "Can you check this for me?",
          "notePt": "Colega próximo, chat rápido."
        },
        "right": {
          "labelEn": "COULD · polite / hierarchy",
          "exampleEn": "Could you review this when you have a moment?",
          "notePt": "Mais educado — supervisor ou email."
        },
        "modelEn": "Can you send the file? · Could you review the contract draft?",
        "modelPt": "Can = direto; Could = mais formal."
      },
