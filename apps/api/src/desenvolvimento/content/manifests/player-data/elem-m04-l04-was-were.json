  "mission": {
    "headlineEn": "You can use was and were.",
    "headlinePt": "Você consegue usar was e were.",
    "bodyPt": "",
    "canDo": ["Yesterday was Monday.", "I was at home.", "They were at the stadium.", "It was great!"],
    "production": {
      "introPt": "Descreva ontem — dia, clima, onde você estava, como se sentiu. Use was/were.",
      "prompts": [
        { "speaker": "Jamie", "questionEn": "How was yesterday?" }
      ],
      "fields": [
        { "id": "day", "labelPt": "Dia", "prefixEn": "Yesterday was", "placeholderEn": "Monday." },
        { "id": "location", "labelPt": "Onde você estava", "prefixEn": "I was", "placeholderEn": "at home." },
        { "id": "weather", "labelPt": "Clima", "prefixEn": "It was", "placeholderEn": "sunny and warm." },
        { "id": "feeling", "labelPt": "Como foi", "prefixEn": "", "placeholderEn": "It was great!" }
      ],
      "exampleEn": "Yesterday was Monday. I was at home. It was sunny and warm. We were tired but happy. It was great!"
    }
  },
  "stepScreens": {
    "context": [
      {
        "id": "e04l04-ctx-01",
        "type": "intro",
        "titleEn": "Was / Were",
        "titlePt": "Was / Were",
        "bodyPt": "To be no passado: I/he/she/it → was. You/we/they → were. Descreve estado, local e identidade no passado."
      },
      {
        "id": "e04l04-ctx-02",
        "type": "scenario",
        "settingEn": "Office · Tuesday morning",
        "scenarioPt": "Jamie pergunta como foi ontem."
      },
      {
        "id": "e04l04-ctx-03",
        "type": "dialogue_choice",
        "speaker": "Jamie",
        "promptEn": "What day was yesterday?",
        "promptPt": "Jamie pergunta que dia era ontem.",
        "options": [
          { "labelEn": "Yesterday was Monday.", "correct": true, "feedbackPt": "Yesterday was — passado." },
          { "labelEn": "Yesterday is Monday.", "correct": false, "feedbackPt": "Is = presente." },
          { "labelEn": "Yesterday were Monday.", "correct": false, "feedbackPt": "Yesterday = singular → was." }
        ]
      },
      {
        "id": "e04l04-ctx-04",
        "type": "dialogue_choice",
        "speaker": "Jamie",
        "promptEn": "Where were you yesterday?",
        "promptPt": "Jamie pergunta onde você estava.",
        "options": [
          { "labelEn": "I was at home.", "correct": true, "feedbackPt": "I → was." },
          { "labelEn": "I were at home.", "correct": false, "feedbackPt": "I usa was, não were." },
          { "labelEn": "I am at home yesterday.", "correct": false, "feedbackPt": "Am = presente." }
        ]
      },
      {
        "id": "e04l04-ctx-05",
        "type": "dialogue_choice",
        "speaker": "Jamie",
        "promptEn": "Were the players at the stadium?",
