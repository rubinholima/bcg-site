        "options": [
          { "labelEn": "Yes, they were at the stadium.", "correct": true, "feedbackPt": "They → were." },
          { "labelEn": "Yes, they was at the stadium.", "correct": false, "feedbackPt": "They usa were." },
          { "labelEn": "Yes, they are at the stadium.", "correct": false, "feedbackPt": "Are = presente." }
        ]
      }
    ],
    "learn": [
      {
        "id": "e04l04-learn-01",
        "type": "phrase_examples",
        "titleEn": "Was — I / he / she / it",
