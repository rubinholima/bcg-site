  "stepScreens": {
    "context": [
      {
        "id": "e04l01-ctx-01",
        "type": "intro",
        "titleEn": "Simple Past intro",
        "titlePt": "Introdução ao Passado Simples",
        "bodyPt": "Presente = agora e rotina. Passado = ação completa que já terminou: yesterday, last week, two days ago."
      },
      {
        "id": "e04l01-ctx-02",
        "type": "scenario",
        "settingEn": "Office · Monday morning",
        "scenarioPt": "Jamie quer saber o que você fez ontem e no fim de semana."
      },
      {
        "id": "e04l01-ctx-03",
        "type": "dialogue_choice",
        "speaker": "Jamie",
        "promptEn": "What did you do yesterday?",
        "promptPt": "Jamie pergunta sobre ontem.",
        "options": [
          { "labelEn": "Yesterday I worked late.", "correct": true, "feedbackPt": "Worked = passado de work." },
          { "labelEn": "Yesterday I work late.", "correct": false, "feedbackPt": "Work = presente." },
          { "labelEn": "Yesterday I am working late.", "correct": false, "feedbackPt": "Am working = agora." }
        ]
      },
      {
        "id": "e04l01-ctx-04",
        "type": "dialogue_choice",
        "speaker": "Jamie",
        "promptEn": "Did you travel last week?",
        "promptPt": "Jamie pergunta sobre semana passada.",
        "options": [
          { "labelEn": "Yes, I traveled for work last week.", "correct": true, "feedbackPt": "Traveled = passado." },
          { "labelEn": "Yes, I travel last week.", "correct": false, "feedbackPt": "Travel = presente." },
          { "labelEn": "Yes, I am traveling last week.", "correct": false, "feedbackPt": "Continuous ≠ passado completo." }
        ]
      },
      {
        "id": "e04l01-ctx-05",
        "type": "dialogue_choice",
        "speaker": "Jamie",
        "promptEn": "When did you finish the report?",
        "promptPt": "Jamie pergunta quando terminou.",
        "options": [
          { "labelEn": "I finished it yesterday.", "correct": true, "feedbackPt": "Finished = passado." },
          { "labelEn": "I finish it yesterday.", "correct": false, "feedbackPt": "Finish = presente." },
          { "labelEn": "I am finishing it yesterday.", "correct": false, "feedbackPt": "Tempo e forma não combinam." }
        ]
      }
    ],
    "learn": [
      {
        "id": "e04l01-learn-01",
        "type": "phrase_examples",
        "titleEn": "Time markers — past",
        "titlePt": "Marcadores — passado",
        "introPt": "Essas palavras indicam Passado Simples.",
        "examples": [
          { "en": "yesterday", "pt": "ontem" },
          { "en": "last week / last month / last year", "pt": "semana/mês/ano passado" },
          { "en": "two days ago", "pt": "dois dias atrás" },
          { "en": "in 2024 / on Monday (past)", "pt": "data passada" }
        ]
      },
      {
        "id": "e04l01-learn-02",
        "type": "phrase_examples",
        "titleEn": "Regular past — preview",
        "titlePt": "Passado regular — preview",
        "introPt": "Muitos verbos formam passado com -ed (lição 2).",
        "examples": [
          { "en": "work → worked", "pt": "trabalhei" },
          { "en": "finish → finished", "pt": "terminei" },
          { "en": "travel → traveled", "pt": "viajei" },
          { "en": "watch → watched", "pt": "assisti" }
        ]
      },
      {
        "id": "e04l01-learn-03",
        "type": "language_focus",
        "titleEn": "Simple Past concept",
        "titlePt": "Conceito do Passado Simples",
        "items": [
          { "formalEn": "Completed action in the past", "naturalEn": "Yesterday I worked. Last week I traveled.", "notePt": "Ação começou e terminou — tempo definido." },
          { "formalEn": "Not now, not habit", "naturalEn": "I work every day (present) vs I worked yesterday (past)", "notePt": "Contraste com START m04 rotina." }
        ],
        "tipPt": "Pergunta-chave: When? If the answer is yesterday/last week → past tense."
      },
      {
        "id": "e04l01-learn-04",
        "type": "phrase_examples",
        "titleEn": "Past sentences",
        "titlePt": "Frases no passado",
        "introPt": "Afirmativas simples no passado.",
        "examples": [
          { "en": "Yesterday I worked late.", "pt": "trabalhei até tarde" },
          { "en": "Last week I traveled.", "pt": "viajei" },
          { "en": "I finished the report.", "pt": "terminei o relatório" },
          { "en": "She called me yesterday.", "pt": "ela me ligou" }
        ]
      },
      {
        "id": "e04l01-learn-05",
        "type": "comparison",
        "titleEn": "Present vs Past",
        "titlePt": "Presente vs Passado",
        "left": {
          "labelEn": "PRESENT · now / habit",
          "exampleEn": "I work every day. I am working now.",
          "notePt": "START m04 + ELEMENTARY m03."
        },
        "right": {
          "labelEn": "PAST · completed",
          "exampleEn": "I worked yesterday. I finished the report.",
          "notePt": "Yesterday, last week → past tense."
        },
        "modelEn": "I work every day, but yesterday I worked from home.",
        "modelPt": "Rotina vs exceção ontem."
      },
      {
