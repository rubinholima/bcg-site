        "examples": [
          { "en": "Look! He is running.", "pt": "Olha! Ele está correndo." },
          { "en": "They are training right now.", "pt": "Estão treinando agora." },
          { "en": "She is stretching at the moment.", "pt": "Ela está alongando." },
          { "en": "We are watching the game.", "pt": "Estamos assistindo." }
        ]
      },
      {
        "id": "e03l02-learn-04",
        "type": "language_focus",
        "titleEn": "Negative — not + -ing",
