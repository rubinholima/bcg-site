  "mission": {
    "headlineEn": "You can describe actions happening now.",
    "headlinePt": "Você consegue descrever ações acontecendo agora.",
    "bodyPt": "",
    "canDo": ["Look! He is running.", "They are training.", "She is stretching.", "I'm not doing anything."],
    "production": {
      "introPt": "Descreva três ações que você vê acontecendo agora — use Look! ou Right now.",
      "prompts": [
        { "speaker": "Jamie", "questionEn": "What's happening on the field right now?" }
      ],
      "fields": [
        { "id": "action1", "labelPt": "Ação 1", "prefixEn": "Look! He is", "placeholderEn": "running." },
        { "id": "action2", "labelPt": "Ação 2", "prefixEn": "They are", "placeholderEn": "training." },
        { "id": "action3", "labelPt": "Ação 3", "prefixEn": "She is", "placeholderEn": "stretching." }
      ],
      "exampleEn": "Look! He is running. They are training on the field. She is stretching near the goal."
    }
  },
  "stepScreens": {
