  "mission": {
    "headlineEn": "Ask for help with a problem.",
    "headlinePt": "Peça ajuda com um problema.",
    "bodyPt": "",
    "canDo": [
      "Could you send someone to fix the heating?",
      "Can someone help me with this leak?",
      "I need someone to look at the plumbing.",
      "Would it be possible to come today?",
      "Is there anyone available this afternoon?"
    ],
    "production": {
      "introPt": "Descreva um problema e peça ajuda de forma educada — inclua urgência e follow-up.",
      "prompts": [{ "speaker": "Building manager", "questionEn": "How can I help?" }],
      "fields": [
        { "id": "problem", "labelPt": "Descrever problema", "prefixEn": "", "placeholderEn": "Something is wrong with the heating — it's not working at all." },
        { "id": "request", "labelPt": "Pedir ajuda", "prefixEn": "", "placeholderEn": "Could you send someone to fix it? Is there anyone available today?" },
        { "id": "followup", "labelPt": "Follow-up", "prefixEn": "", "placeholderEn": "It's urgent — we have no hot water." }
      ],
      "exampleEn": "Something is wrong with the heating. Could you send someone to fix it? Is there anyone available today? It's urgent — we have no hot water."
    }
  },
  "stepScreens": {
