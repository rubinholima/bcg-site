        { "en": "Could you give me a hand?", "pt": "me ajudar" }
      ]},
      { "id": "em06l06-learn-02", "type": "phrase_examples", "titleEn": "Can someone...? / I need someone to...", "titlePt": "Can someone...? / I need someone to...", "introPt": "Quando não sabe quem vai ajudar:", "examples": [
        { "en": "Can someone help me with this?", "pt": "alguém pode ajudar?" },
        { "en": "I need someone to look at the plumbing.", "pt": "preciso de alguém" },
        { "en": "Is there anyone available?", "pt": "tem alguém disponível?" },
        { "en": "Do you know who I should contact?", "pt": "quem contatar" }
      ]},
      { "id": "em06l06-learn-03", "type": "phrase_examples", "titleEn": "Would it be possible...?", "titlePt": "Would it be possible...?", "introPt": "Ainda mais formal/educado:", "examples": [
        { "en": "Would it be possible to come today?", "pt": "vir hoje?" },
        { "en": "Would it be possible to send a technician?", "pt": "enviar técnico?" },
        { "en": "Would you mind taking a look?", "pt": "se importa de olhar?" },
        { "en": "When would be a good time?", "pt": "qual horário?" }
      ]},
      { "id": "em06l06-learn-04", "type": "phrase_examples", "titleEn": "Adding urgency politely", "titlePt": "Urgência com educação", "introPt": "Quando é importante:", "examples": [
