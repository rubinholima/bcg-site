        { "en": "I'd really appreciate it if someone could come today.", "pt": "agradeceria" },
        { "en": "It's affecting my work.", "pt": "impacto" }
      ]},
      { "id": "em06l06-learn-05", "type": "language_focus", "titleEn": "Could vs Can for requests", "titlePt": "Could vs Can para pedidos", "items": [
        { "formalEn": "Could you send someone?", "naturalEn": "More polite than Can you.", "notePt": "Could = mais educado." },
        { "formalEn": "Can you help me?", "naturalEn": "Ok with colleagues.", "notePt": "Can = informal ok." },
        { "formalEn": "Could you to send someone?", "naturalEn": "Could you send — no 'to'.", "notePt": "Could + subject + base verb." }
      ], "tipPt": "Problema + Could you...? + urgência (se necessário) + follow-up sobre horário." },
