    "mission": [{ "id": "m05l02-miss-01", "type": "mission_intro", "headlineEn": "Describe Maria.", "headlinePt": "Descreva Maria.", "bodyPt": "Use He is/She is para aparência e personalidade.", "prompts": [{ "speaker": "Visitor", "questionEn": "What is Maria like?" }] }]
