        { "id": "close", "labelPt": "Encerrar", "prefixEn": "", "placeholderEn": "Thanks, everyone. See you tomorrow." }
      ],
      "exampleEn": "Sounds good — I agree. — No questions from me. — Thanks, everyone. See you tomorrow."
    }
  },
