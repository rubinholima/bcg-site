        { "speaker": "Manager", "questionEn": "Let's start. Here's the agenda for today." },
        { "speaker": "Manager", "questionEn": "Any questions?" },
        { "speaker": "Manager", "questionEn": "Thanks, everyone. See you tomorrow." }
