    "canDo": [
      "Could I...?",
      "Would it be OK if...?",
      "May I...?",
      "Sure, no problem."
    ],
    "production": {
      "introPt": "Faça dois pedidos de permissão (Could I / Would it be OK if) e uma confirmação quando aceitarem.",
      "prompts": [
        {
          "speaker": "Supervisor",
          "questionEn": "What do you need?"
        }
      ],
      "fields": [
        {
          "id": "req1",
          "labelPt": "Pedido 1 — Could I",
          "prefixEn": "Could I",
          "placeholderEn": "leave at 3 PM today? I have an appointment."
        },
        {
          "id": "req2",
          "labelPt": "Pedido 2 — Would it be OK if",
          "prefixEn": "Would it be OK if",
          "placeholderEn": "I worked from home on Friday?"
        },
        {
          "id": "thanks",
          "labelPt": "Agradecer e confirmar",
          "prefixEn": "",
          "placeholderEn": "Thanks! I'll update the team."
        }
      ],
      "exampleEn": "Could I leave at 3 PM? I have an appointment. Would it be OK if I worked from home Friday? Thanks — I'll update the team."
    }
  },
