  "stepScreens": {
    "context": [
      {
        "id": "em01-l01-ctx-01",
        "type": "intro",
        "titleEn": "Beyond START — personal details",
        "titlePt": "Além do START — detalhes pessoais",
        "bodyPt": "Você já sabe nome, origem e profissão básica. Agora a conversa aprofunda: casado ou solteiro? Onde mora hoje? Onde trabalha agora? Frases mais longas, mais inglês, menos tradução do português."
      },
      {
        "id": "em01-l01-ctx-02",
        "type": "scenario",
        "settingEn": "Office lounge · After-work mixer",
        "scenarioPt": "Alex encontra você num happy hour da empresa. A conversa sai do básico e entra em detalhes pessoais — estado civil, moradia e trabalho atual."
      },
      {
        "id": "em01-l01-ctx-03",
        "type": "dialogue_choice",
        "speaker": "Alex",
        "promptEn": "So, are you married or single?",
        "promptPt": "Alex pergunta estado civil — comum em conversa informal nos EUA.",
        "options": [
          {
            "labelEn": "I'm single.",
            "correct": true,
            "feedbackPt": "Resposta direta e natural."
          },
          {
            "labelEn": "I am single person.",
            "correct": false,
            "feedbackPt": "Redundante — single já basta."
          },
          {
            "labelEn": "I have single.",
            "correct": false,
            "feedbackPt": "Tradução literal — use BE (I'm single)."
          }
        ]
      },
      {
        "id": "em01-l01-ctx-04",
        "type": "dialogue_choice",
        "speaker": "Alex",
        "promptEn": "Where do you live now?",
        "promptPt": "Alex quer saber onde você mora atualmente — now enfatiza o presente.",
        "options": [
          {
            "labelEn": "I live in Boston now.",
            "correct": true,
            "feedbackPt": "Now = situação atual — natural."
          },
          {
            "labelEn": "I live in Boston yesterday.",
            "correct": false,
            "feedbackPt": "Yesterday é passado — moradia é presente."
          },
          {
            "labelEn": "I am live in Boston.",
            "correct": false,
            "feedbackPt": "Live é verbo — não use am antes de live."
          }
        ]
      },
      {
        "id": "em01-l01-ctx-05",
        "type": "dialogue_choice",
        "speaker": "Alex",
        "promptEn": "And where do you work now?",
        "promptPt": "Alex conecta moradia e trabalho — pergunta sobre emprego atual.",
        "options": [
          {
            "labelEn": "I work at the club's office downtown.",
            "correct": true,
            "feedbackPt": "At + local — resposta completa."
          },
          {
            "labelEn": "I work in the club office downtown.",
            "correct": false,
            "feedbackPt": "In funciona para departamento; aqui at + local físico é mais natural."
          },
          {
            "labelEn": "I am work at downtown.",
            "correct": false,
            "feedbackPt": "Gramaticalmente incorreto — I work, não I am work."
          }
        ]
      },
      {
        "id": "em01-l01-ctx-06",
        "type": "dialogue_choice",
        "speaker": "Alex",
        "promptEn": "Nice! I'm married, actually. Two kids.",
        "promptPt": "Alex compartilha sobre si. Como devolver interesse?",
        "options": [
          {
            "labelEn": "Oh, really? Tell me more.",
            "correct": true,
            "feedbackPt": "Follow-up natural — mostra interesse."
          },
          {
            "labelEn": "Where do you live now?",
            "correct": false,
            "feedbackPt": "Muda de assunto abruptamente."
          },
          {
            "labelEn": "I am single.",
            "correct": false,
            "feedbackPt": "Só repete sobre você — não reage ao que Alex disse."
          }
        ]
      }
    ],
