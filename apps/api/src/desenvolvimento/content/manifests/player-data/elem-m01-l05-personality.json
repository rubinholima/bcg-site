          {
            "formalEn": "She is outgoing person.",
            "naturalEn": "She's outgoing.",
            "notePt": "Adjetivo direto — sem person redundante."
          }
        ],
        "tipPt": "Em impressões iniciais, seems soa mais natural e menos definitivo."
      },
