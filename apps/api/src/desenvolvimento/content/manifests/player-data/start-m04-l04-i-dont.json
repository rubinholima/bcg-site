        "examples": [
          { "en": "Do you work on weekends? — No, I don't.", "pt": "pergunta + resposta" },
          { "en": "Does he train on Sundays? — No, he doesn't.", "pt": "3ª pessoa" },
          { "en": "Do they watch TV? — No, they don't.", "pt": "plural" }
        ]
      },
      {
