        { "id": "she", "labelPt": "O que ela não faz (she)", "prefixEn": "She doesn't", "placeholderEn": "watch TV." }
      ],
      "exampleEn": "I don't work on weekends. I don't have breakfast at home. He doesn't train on Sundays. She doesn't watch TV."
    }
