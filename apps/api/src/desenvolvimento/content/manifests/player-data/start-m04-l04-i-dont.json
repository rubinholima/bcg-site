        "id": "m04l04-learn-04",
        "type": "language_focus",
        "titleEn": "Negative rule",
        "titlePt": "Regra da negativa",
        "items": [
          { "formalEn": "I don't works on weekends.", "naturalEn": "I don't work on weekends.", "notePt": "Após don't/doesn't, verbo SEMPRE na base — sem -s." },
          { "formalEn": "He don't train.", "naturalEn": "He doesn't train.", "notePt": "He/she/it = doesn't, nunca don't." }
        ],
        "tipPt": "Fórmula: Sujeito + don't/doesn't + verbo base."
      },
      {
        "id": "m04l04-learn-05",
