        { "id": "temporary", "labelPt": "Temporário", "prefixEn": "", "placeholderEn": "I'm staying at a hotel this week." },
        { "id": "home", "labelPt": "Em casa agora", "prefixEn": "", "placeholderEn": "At home, the kids are doing homework." },
        { "id": "question", "labelPt": "Uma pergunta sua", "prefixEn": "", "placeholderEn": "What are you doing right now?" }
      ],
      "exampleEn": "I work every day, but right now I am working from home. The team is having a meeting. I'm staying at a hotel this week. At home, the kids are doing homework. What are you doing?"
    }
  },
