    "canDo": [
      "I am working. / I work every day.",
      "They are having a meeting.",
      "I'm staying at a hotel this week.",
      "What are you doing? / What do you usually do?"
    ],
    "production": {
      "introPt": "Monte uma conversa completa — rotina (simple), o que acontece agora (continuous), situação temporária e contraste. Use apenas lições 1 a 6.",
      "prompts": [
        { "speaker": "Jamie", "questionEn": "What's happening? Tell me everything." }
      ],
      "fields": [
        { "id": "routine", "labelPt": "Rotina (simple)", "prefixEn": "", "placeholderEn": "I work every day. I usually train on weekdays." },
