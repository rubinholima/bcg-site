        "type": "phrase_examples",
        "titleEn": "Bonus irregulars",
        "titlePt": "Irregulares extras",
        "introPt": "Outros muito frequentes no dia a dia.",
        "examples": [
          { "en": "come → came", "pt": "vir → vim" },
          { "en": "get → got", "pt": "pegar/conseguir → peguei" },
          { "en": "make → made", "pt": "fazer → fiz (make)" },
          { "en": "take → took", "pt": "levar → levei" }
        ]
      },
      {
        "id": "e04l03-learn-05",
        "type": "comparison",
        "titleEn": "Regular vs irregular",
        "titlePt": "Regular vs irregular",
        "left": {
          "labelEn": "REGULAR · -ed",
          "exampleEn": "watch → watched · play → played · visit → visited",
          "notePt": "Regra previsível — lição 2."
        },
        "right": {
          "labelEn": "IRREGULAR · memorize",
          "exampleEn": "go → went · have → had · see → saw · do → did",
          "notePt": "Forma diferente — não invente goed/haved."
        },
        "modelEn": "I watched the game (regular) and went home (irregular).",
        "modelPt": "Na mesma frase, misture regular e irregular."
      },
      {
        "id": "e04l03-learn-06",
        "type": "language_focus",
        "titleEn": "Have — two meanings",
        "titlePt": "Have — dois significados",
        "items": [
          { "formalEn": "Have = possess", "naturalEn": "I have a car. (present)", "notePt": "Posse usa have no presente." },
          { "formalEn": "Have = experience / meal", "naturalEn": "I had a great time. I had lunch.", "notePt": "Experiência ou refeição no passado → had." }
        ],
        "tipPt": "Had a good time / had lunch / had fun — expressões fixas no passado."
      },
      {
        "id": "e04l03-learn-07",
        "type": "mistake",
        "titlePt": "Erro comum",
        "wrongEn": "I goed to the beach. / We haved fun. / I seed the game.",
        "rightEn": "I went to the beach. / We had fun. / I saw the game.",
        "explanationPt": "Irregulares não seguem -ed. Goed, haved, seed não existem — memorize went, had, saw."
      },
      {
        "id": "e04l03-learn-08",
        "type": "review",
        "titleEn": "Quick review",
        "titlePt": "Revisão rápida",
        "items": [
          { "en": "go → went · I went to the beach.", "pt": "ir" },
          { "en": "have → had · We had a great time.", "pt": "ter/experiência" },
          { "en": "see → saw · I saw the game.", "pt": "ver" },
          { "en": "do → did · What did you do?", "pt": "fazer" },
          { "en": "No goed / haved / seed!", "pt": "não invente" }
        ]
      }
    ],
