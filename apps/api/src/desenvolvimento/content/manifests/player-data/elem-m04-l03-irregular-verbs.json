  "mission": {
    "headlineEn": "You can use common irregular past verbs.",
    "headlinePt": "Você consegue usar irregulares comuns no passado.",
    "bodyPt": "",
    "canDo": ["I went to the beach.", "We had a great time.", "I saw the game.", "What did you do?"],
    "production": {
      "introPt": "Conte seu fim de semana passado usando went, had, saw e did — pelo menos uma frase com cada.",
      "prompts": [
        { "speaker": "Jamie", "questionEn": "What did you do last weekend?" }
      ],
      "fields": [
        { "id": "went", "labelPt": "Go → went", "prefixEn": "I went", "placeholderEn": "to the beach." },
        { "id": "had", "labelPt": "Have → had", "prefixEn": "We had", "placeholderEn": "a great time." },
        { "id": "saw", "labelPt": "See → saw", "prefixEn": "I saw", "placeholderEn": "the game." },
        { "id": "did", "labelPt": "Do → did", "prefixEn": "I did", "placeholderEn": "a lot of things." }
      ],
      "exampleEn": "Last weekend I went to the beach. We had a great time. I saw the game on TV. I did a lot of things — it was fun!"
    }
  },
  "stepScreens": {
    "context": [
      {
        "id": "e04l03-ctx-01",
        "type": "intro",
        "titleEn": "Irregular verbs",
        "titlePt": "Verbos irregulares",
        "bodyPt": "Alguns verbos NÃO usam -ed no passado. Os mais comuns: go→went, have→had, see→saw, do→did. Memorize — não há regra fixa."
      },
      {
        "id": "e04l03-ctx-02",
        "type": "scenario",
        "settingEn": "Office · Monday morning",
        "scenarioPt": "Jamie quer ouvir sobre seu fim de semana passado."
      },
      {
        "id": "e04l03-ctx-03",
        "type": "dialogue_choice",
        "speaker": "Jamie",
        "promptEn": "Where did you go last weekend?",
        "promptPt": "Jamie pergunta onde você foi.",
        "options": [
          { "labelEn": "I went to the beach.", "correct": true, "feedbackPt": "Go → went (irregular)." },
          { "labelEn": "I go to the beach.", "correct": false, "feedbackPt": "Go = presente." },
          { "labelEn": "I goed to the beach.", "correct": false, "feedbackPt": "Goed não existe — went." }
        ]
      },
      {
        "id": "e04l03-ctx-04",
        "type": "dialogue_choice",
        "speaker": "Jamie",
        "promptEn": "Did you have a good time?",
        "promptPt": "Jamie pergunta se foi bom.",
        "options": [
          { "labelEn": "Yes, we had a great time!", "correct": true, "feedbackPt": "Have → had." },
          { "labelEn": "Yes, we have a great time.", "correct": false, "feedbackPt": "Have = presente." },
          { "labelEn": "Yes, we haved a great time.", "correct": false, "feedbackPt": "Haved não existe — had." }
        ]
      },
      {
        "id": "e04l03-ctx-05",
        "type": "dialogue_choice",
        "speaker": "Jamie",
        "promptEn": "Did you see the game?",
