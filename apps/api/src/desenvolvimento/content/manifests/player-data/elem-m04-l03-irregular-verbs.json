        "options": [
          { "labelEn": "Yes, I saw it on TV.", "correct": true, "feedbackPt": "See → saw." },
          { "labelEn": "Yes, I see it on TV.", "correct": false, "feedbackPt": "See = presente." },
          { "labelEn": "Yes, I seed it on TV.", "correct": false, "feedbackPt": "Seed não existe — saw." }
        ]
      }
    ],
