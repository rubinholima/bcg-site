        { "en": "I need help with this file.", "pt": "arquivo" },
        { "en": "I need help with sending the email.", "pt": "enviar email" }
      ]},
      { "id": "m06l03-learn-04", "type": "phrase_examples", "titleEn": "Could you...?", "titlePt": "Seria possível...?", "introPt": "Could you = mais educado que Can you — ideal com manager ou cliente interno.", "examples": [
        { "en": "Could you help me?", "pt": "ajuda geral" },
        { "en": "Could you show me?", "pt": "mostrar" },
        { "en": "Could you check this?", "pt": "verificar" },
        { "en": "Could you explain that?", "pt": "explicar" }
      ]},
      { "id": "m06l03-learn-05", "type": "phrase_examples", "titleEn": "Responses", "titlePt": "Respostas", "introPt": "Como colega responde — e como você agradece.", "examples": [
        { "en": "Sure, no problem.", "pt": "claro" },
        { "en": "Of course. What do you need?", "pt": "o que precisa?" },
        { "en": "I'm busy right now — can we do it in ten minutes?", "pt": "adiar" },
        { "en": "Thanks, I really appreciate it.", "pt": "agradecer" }
      ]},
      { "id": "m06l03-learn-06", "type": "comparison", "titleEn": "Can you vs Could you", "titlePt": "Can vs Could", "left": { "labelEn": "CAN YOU · DIRECT", "exampleEn": "Can you help me with this file?", "notePt": "Normal entre colegas — direto e ok." }, "right": { "labelEn": "COULD YOU · POLITE", "exampleEn": "Could you help me with this file?", "notePt": "Mais suave — manager, cliente, situação formal." }, "modelEn": "Can you help me? → Could you show me how? (escala educação)", "modelPt": "Ambos funcionam — Could soa mais educado." },
      { "id": "m06l03-learn-07", "type": "mistake", "titlePt": "Erro comum de brasileiros", "wrongEn": "I need help for the report.", "rightEn": "I need help with the report.", "explanationPt": "Help with + tarefa. For indica benefício ('help for you'), não o objeto da ajuda." },
      { "id": "m06l03-learn-08", "type": "review", "titleEn": "Quick review", "titlePt": "Revisão rápida", "items": [
        { "en": "I need help.", "pt": "pedido direto" },
