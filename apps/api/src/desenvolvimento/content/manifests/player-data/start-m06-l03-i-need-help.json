      "prompts": [{ "speaker": "You", "questionEn": "(You need help with the travel report.)" }],
      "fields": [
        { "id": "ask", "labelPt": "Pedir ajuda", "prefixEn": "", "placeholderEn": "Hi Alex — can you help me?" },
        { "id": "detail", "labelPt": "Especificar", "prefixEn": "I need help with", "placeholderEn": "the travel report." }
      ],
      "exampleEn": "Hi Alex — can you help me? I need help with the travel report."
    }
  },
  "stepScreens": {
    "context": [
      { "id": "m06l03-ctx-01", "type": "intro", "titleEn": "I need help", "titlePt": "Preciso de ajuda", "bodyPt": "Pedir ajuda em inglês no trabalho é normal e esperado. Can you help me? e I need help with... soam educados e diretos." },
      { "id": "m06l03-ctx-02", "type": "scenario", "settingEn": "Office · Stuck on a task", "scenarioPt": "Você está no relatório de viagem e não entende um campo no sistema." },
