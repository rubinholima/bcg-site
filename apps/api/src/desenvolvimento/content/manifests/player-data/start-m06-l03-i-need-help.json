        { "en": "I need help with the report.", "pt": "especificar" },
        { "en": "Could you show me?", "pt": "mais educado" },
        { "en": "Sure, no problem.", "pt": "resposta" },
        { "en": "What do you need?", "pt": "pergunta do colega" },
        { "en": "Thanks, I appreciate it.", "pt": "agradecer" }
      ]}
