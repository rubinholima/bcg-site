    "learn": [
      { "id": "m06l03-learn-01", "type": "phrase_examples", "titleEn": "I need help", "titlePt": "Preciso de ajuda", "introPt": "Frase direta e educada — comum quando você está travado.", "examples": [
        { "en": "I need help.", "pt": "preciso de ajuda" },
