      { "id": "m06l03-learn-02", "type": "phrase_examples", "titleEn": "Can you help me?", "titlePt": "Pode me ajudar?", "introPt": "Pergunta padrão — Can you + verbo.", "examples": [
        { "en": "Can you help me?", "pt": "pedido geral" },
        { "en": "Can you help me with this?", "pt": "com isto" },
