    "imitate": [{ "id": "m06l03-imit-01", "type": "read_repeat", "titleEn": "Read & Repeat", "titlePt": "Leia e repita", "introPt": "Pratique pedir e responder ajuda.", "phrases": [
      { "en": "Can you help me?" }, { "en": "I need help with the report." }, { "en": "Could you show me how?" }, { "en": "Sure, no problem." }, { "en": "What do you need?" }, { "en": "I need help with this file." }, { "en": "Thanks, I really appreciate it." }, { "en": "Could you check this for me?" }
    ], "dialogueEn": "Can you help me? — Sure! What do you need? — I need help with the travel report. — Could you show me how to fill this in? — Of course." }],
    "mission": [{ "id": "m06l03-miss-01", "type": "mission_intro", "headlineEn": "Ask Alex for help.", "headlinePt": "Peça ajuda ao Alex.", "bodyPt": "Use Can/Could e especifique a tarefa.", "prompts": [{ "speaker": "You", "questionEn": "(You need help with the travel report.)" }] }]
