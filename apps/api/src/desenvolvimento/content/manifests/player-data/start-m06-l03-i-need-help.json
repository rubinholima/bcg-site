        { "labelEn": "Could you show me how to fill this in?", "correct": true, "feedbackPt": "Could you = mais educado que can." },
        { "labelEn": "Show me you could.", "correct": false, "feedbackPt": "Ordem incorreta." },
        { "labelEn": "You show now.", "correct": false, "feedbackPt": "Imperativo seco — falta educação." }
