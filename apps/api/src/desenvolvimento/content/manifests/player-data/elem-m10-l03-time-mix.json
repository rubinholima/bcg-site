  "mission": {
    "headlineEn": "Mix now, past and future.",
    "headlinePt": "Misture agora, passado e futuro.",
    "bodyPt": "",
    "canDo": [
      "I'm ...ing now",
      "Yesterday I...",
      "I'm going to...",
      "I'll..."
    ],
    "production": {
      "introPt": "Responda sobre agora, ontem e fim de semana — três tempos.",
      "prompts": [
        {
          "speaker": "Jamie",
          "questionEn": "Quick time mix — now, yesterday, weekend?"
        }
      ],
      "fields": [
        {
          "id": "now",
          "labelPt": "Agora (continuous)",
          "prefixEn": "Right now I'm",
          "placeholderEn": "finishing the travel report."
        },
        {
          "id": "past",
          "labelPt": "Ontem (past)",
          "prefixEn": "Yesterday I",
          "placeholderEn": "met with the medical team."
        },
        {
          "id": "future",
          "labelPt": "Fim de semana (going to)",
          "prefixEn": "This weekend I'm going to",
          "placeholderEn": "visit my family."
        },
        {
          "id": "will",
          "labelPt": "Decisão espontânea (will)",
          "prefixEn": "",
          "placeholderEn": "Actually, I'll join the team dinner tonight."
        }
      ],
      "exampleEn": "Right now I'm finishing the report. Yesterday I met the team. This weekend I'm going to visit family. I'll join dinner tonight."
    }
  },
