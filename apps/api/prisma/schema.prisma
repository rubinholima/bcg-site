/** Vestuário/uniformes (Beatscode): grupos (Superior/Inferior/Calçados) → categorias → peças; kits reúnem peças por tipo de uniforme. */
model LogisticsClothingGroup {
  id          String   @id @default(cuid())
  name        String   @unique
  beatscodeId Int?     @unique
  isSystem    Boolean  @default(false)
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  categories LogisticsClothingCategory[]
  items      LogisticsClothingItem[]
}

model LogisticsClothingCategory {
  id          String                 @id @default(cuid())
  name        String
  groupId     String
  group       LogisticsClothingGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  beatscodeId Int?                   @unique
  isSystem    Boolean                @default(false)
  active      Boolean                @default(true)
  sortOrder   Int                    @default(0)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  items LogisticsClothingItem[]

  @@unique([groupId, name])
  @@index([groupId])
}

model LogisticsUniformType {
  id          String   @id @default(cuid())
  name        String   @unique // Jogo, Passeio, Treino, Viagem…
  beatscodeId Int?     @unique
  isSystem    Boolean  @default(false)
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
