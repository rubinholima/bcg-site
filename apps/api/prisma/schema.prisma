  updatedAt   DateTime @updatedAt
  @@index([tenantId, category])
  @@index([tenantId, sessionDate])
  @@index([staffId])
  @@index([agendaEntryId])
  @@index([planTemplateId])
}

model CoachTrainingPlanTemplate {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category     String?
  title        String
  fileUrl      String
  notes        String?  @db.Text
  authorUserId String?
  sessions     CoachTrainingSession[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  @@index([tenantId, category])
}

model CoachTrainingSessionAttachment {
  id        String @id @default(cuid())
  sessionId String
  session   CoachTrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  label     String?
  fileUrl   String
  kind      String? // plano_treino | video_referencia | outro
  @@index([sessionId])
}

model CoachTrainingActivity {
  id              String @id @default(cuid())
  sessionId       String
  session         CoachTrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  kind            String // aquecimento | desenvolvimento | principal | encerramento
  title           String
  description     String? @db.Text
  durationMinutes Int?
  sortOrder       Int    @default(0)
  mediaUrl        String?
  @@index([sessionId, sortOrder])
}

model CoachTrainingPlayerEntry {
  id                String @id @default(cuid())
  sessionId         String
  session           CoachTrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  playerId          String
  player            Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  available         Boolean @default(true)
  unavailableReason String?
  rating            Float?
  notes             String? @db.Text
  @@unique([sessionId, playerId])
  @@index([playerId])
}

/** Estatísticas complementares de jogo (posse, bolas paradas) — manual ou ajuste sobre dados oficiais. */
model CoachMatchStatOverride {
  id                 String   @id @default(cuid())
  tenantId           String
  tenant             Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category           String?
  fmfMatchReportId   String?  @unique
  fmfMatchReport     FmfMatchReport? @relation(fields: [fmfMatchReportId], references: [id], onDelete: Cascade)
  travelLogisticsId  String?  @unique
  matchDate          DateTime
  opponentName       String?
  goalsFor           Int?
  goalsAgainst       Int?
  yellowCards        Int?
  redCards           Int?
  possessionPct      Int?
  setPiecesFor       Int?
  setPiecesAgainst   Int?
  notes              String?  @db.Text
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  @@index([tenantId, category])
  @@index([tenantId, matchDate])
}
