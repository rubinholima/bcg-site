/** Áreas exibidas na agenda unificada (Futebol, Psicologia, etc.). */
model AgendaArea {
  id         String   @id @default(cuid())
  slug       String   @unique
  label      String
  /// Chave interna para buscar eventos (futebol, consultas, boston-hall, marketing)
  dataSource String
  /// Módulo necessário quando isPublic=false; null = só isPublic ou dashboard
  moduleSlug String?
  isPublic   Boolean  @default(false)
  manageHref String
  createHref String?
  sortOrder  Int      @default(0)
  active     Boolean  @default(true)
  isSystem   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

/** Categorias/tipos de evento com cor fixa na agenda (Aniversário, Jogo fora, etc.). */
model AgendaEventCategory {
  id          String   @id @default(cuid())
  slug        String   @unique
  label       String
  /// Área (slug AgendaArea); null = categorias de futebol por tipo
  areaSlug    String?
  /// Tipo bruto futebol: aniversario, jogo, viagem, treino…
  eventType   String?
  /// casa | fora — refinamento de jogo/viagem
  matchSide   String?
  bgColor     String
  textColor   String
  borderColor String
  sortOrder   Int      @default(0)
  active      Boolean  @default(true)
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([areaSlug])
  @@index([eventType])
}

/** Compromissos operacionais do Depto Futebol (treinos, reuniões, jogos, etc.) — exibidos na agenda junto com viagens. */
model FootballAgendaEntry {
  id                String            @id @default(cuid())
  tenantId          String
  tenant            Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category          String?
  type              String            // treino | reuniao | jogo | compromisso | preparacao | outro
  title             String
  startAt           DateTime
  endAt             DateTime?
  allDay            Boolean           @default(false)
  /** manha | tarde | noite — compromisso por período do dia (além de horário fino / dia inteiro) */
  dayPeriod         String?
  location          String?
  description       String?           @db.Text
  status            String            @default("confirmado") // confirmado | provisorio | cancelado
  travelLogisticsId String?
  travelLogistics   TravelLogistics?  @relation(fields: [travelLogisticsId], references: [id], onDelete: SetNull)
  spaceId           String?
  space             FootballActivitySpace? @relation(fields: [spaceId], references: [id], onDelete: SetNull)
  participants      FootballAgendaEntryParticipant[]
  coachTrainingSessions CoachTrainingSession[]
  /// beatscode-schedule-* ou beatscode-match-* — reimport idempotente
  externalId        String?
  beatscodeMeta     Json?
  /** true = edição manual; sync FMF não sobrescreve */
  agendaLocked      Boolean           @default(false)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  @@index([tenantId, startAt])
  @@index([travelLogisticsId])
  @@index([spaceId])
  @@index([tenantId, spaceId, startAt])
  @@unique([tenantId, externalId])
}

/** Locais de treino / reunião / atendimento por clube (Campo 1, sala, etc.) */
model FootballActivitySpace {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  slug      String?
  address   String?  @db.Text
  notes     String?  @db.Text
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  agendaEntries FootballAgendaEntry[]
  @@unique([tenantId, name])
  @@index([tenantId])
}

model FootballAgendaEntryParticipant {
  id        String              @id @default(cuid())
  entryId   String
  entry     FootballAgendaEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  playerId  String
  player    Player              @relation(fields: [playerId], references: [id], onDelete: Cascade)
  createdAt DateTime            @default(now())
  @@unique([entryId, playerId])
  @@index([playerId])
}

// Evento (copa, torneio, etc.) — promovido pelo grupo ou tenant; landing page modular
model Event {
  id          String    @id @default(cuid())
  slug        String    @unique // ex.: coffee-tournament
  name        String    // Nome exibido (ex.: Coffee Tournament)
  description String?   @db.Text
  organizer   String    // group | tenant — quem promove
  tenantId    String?   // preenchido quando organizer=tenant
  tenant      Tenant?   @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  category    String    @default("football") // football | other
  /// Faixa do torneio (principal, sub15, …) — página pública do evento usa só esta categoria nos filtros de jogos
  fixtureCategory String?
  startDate   DateTime?
  endDate     DateTime?
  logoUrl     String?
  content            Json      // { theme?, blocks: [{ id, type, sortOrder, config }] } — mesmo formato que Page
  competitionFormat  Json?     // { formatType, clubsCount, ... } — quando category=football
  status             String    @default("draft") // draft | published | archived
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  photos       EventPhoto[]
  galleryLinks EventGalleryLink[]
  uploadTokens EventUploadToken[]
  @@index([organizer])
  @@index([tenantId])
  @@index([category])
  @@index([status])
}

// Foto do evento — upload por fotógrafos; exibida na galeria pública e em links compartilhados
model EventPhoto {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  s3Key     String   // media/eventos/{eventId}/{uuid}.{ext}
  caption   String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  @@index([eventId])
}

// Link compartilhável da galeria — temporário (expira) ou permanente
model EventGalleryLink {
  id        String    @id @default(cuid())
  eventId   String
  event     Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  token     String    @unique // token na URL: /eventos/gallery/{token}
  expiresAt DateTime? // null = permanente; preenchido = temporário
  createdAt DateTime  @default(now())
  @@index([eventId])
  @@index([token])
}

// Token para fotógrafos fazerem upload na página pública — /eventos/upload/{token}
model EventUploadToken {
  id        String    @id @default(cuid())
  eventId   String
  event     Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  token     String    @unique
  expiresAt DateTime? // null = permanente
  createdAt DateTime  @default(now())
  @@index([eventId])
  @@index([token])
}

// --- Imprensa do clube (assessoria, fotos de jogos, links para jornalistas) ---

model TenantPressPhoto {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  s3Key      String   // media/imprensa/{tenantId}/{uuid}.{ext}
  caption    String?
  matchLabel String?  // ex.: Villa Nova x América — 15/03/2025
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  @@index([tenantId])
}

model TenantPressGalleryLink {
  id        String    @id @default(cuid())
  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  token     String    @unique // /clube/galeria/{token}
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  @@index([tenantId])
  @@index([token])
}

model TenantPressUploadToken {
  id        String    @id @default(cuid())
  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  token     String    @unique // /clube/upload/{token}
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  @@index([tenantId])
  @@index([token])
}

/// Código temporário para acessar a página de imprensa (modo menu)
model TenantPressPageAccessCode {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code      String   // ex.: K7M2P9 — legível, maiúsculas
  label     String?
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([expiresAt])
}

model TenantPressCredentialRequest {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name       String
  email      String
  phone      String?
  outlet     String?
  document   String?
  eventLabel String?
  notes      String?  @db.Text
  status     String   @default("pending")
  createdAt  DateTime @default(now())
  @@index([tenantId])
  @@index([status])
}

// Página específica de uma empresa (conteúdo modular: blocos hero, destaque, texto, etc.)
model Page {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  slug       String   @default("main") // ex.: main, sobre
  title      String?  // Título para o dashboard
  content    Json     // { blocks: [{ id, type, sortOrder, config }] }
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  @@unique([tenantId, slug])
}

// Contas de email gerenciadas via WorkMail (por empresa)
model WorkMailAccount {
  id            String   @id @default(cuid())
  organizationId String  // id da empresa (Tenant) no nosso sistema
  organization   Tenant  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String   // localPart@domain
  localPart      String
  displayName    String?
  workmailUserId String   // ID retornado pela AWS WorkMail
  status         String   // ACTIVE | DISABLED | DELETED
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  @@unique([organizationId, email])
}

// Audit simples: quem fez, quando, ação (WorkMail)
model WorkMailAuditLog {
  id          String   @id @default(cuid())
  performedBy String   // sub ou email do JWT
  action      String   // CREATE_ACCOUNT | RESET_PASSWORD | DELETE_ACCOUNT
  targetType  String   // account
  targetId    String?
  details     String?  @db.Text
  createdAt   DateTime @default(now())
}

// Conteúdo editável da home pública (textos PT/EN e URLs de imagens)
model HomeContent {
  id        String   @id @default(cuid())
  slug      String   @unique // "home"
  content   Json     // { pt: {...}, en: {...}, images: { hero?, what?, founder?, cta? } }
  updatedAt DateTime @updatedAt
}

// Nome exibido para arquivos de mídia no S3 (key = caminho no bucket, displayName = nome amigável)
model MediaMeta {
  id          String   @id @default(cuid())
  key         String   @unique // ex: media/hero/uuid.jpg
  displayName String?  // nome para exibir no menu e listagem
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Módulos do dashboard (Grupo Master, Empresas, Usuários, etc.)
model Module {
  id              String   @id @default(cuid())
  slug            String   @unique
  name            String
  sortOrder       Int      @default(0)
  /// Agrupamento lógico na UI de permissões (Configurações → Módulos). Chave estável: estrategico, empresa_usuarios, etc.
  functionalArea  String   @default("outros")
  /// Módulo de API liberado junto com este slug de menu (ex.: adm__adm_clientes → adm_financeiro).
  impliesSlug     String?
  roles           ModuleRole[]
  userAccess      UserModuleAccess[]
  @@index([functionalArea])
}

/// Permissões individuais por usuário (quando User.customModuleAccess = true).
model UserModuleAccess {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  moduleId  String
  module    Module  @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  canAccess Boolean @default(true)
  @@unique([userId, moduleId])
  @@index([userId])
  @@index([moduleId])
}

/// Auditoria de alterações na matriz de permissões (super admin). Não altera o modelo de autorização em runtime.
model PermissionMatrixAudit {
  id          String   @id @default(cuid())
  actorSub    String
  actorEmail  String?
  createdAt   DateTime @default(now())
  /// Lista de mudanças: [{ slug, role, from, to }]
  changes     Json
  @@index([createdAt])
}

// Quais roles podem acessar cada módulo (super_admin sempre pode)
model ModuleRole {
  id       String  @id @default(cuid())
  moduleId String
  module   Module  @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  role     String  // slug do PlatformRole (company_admin, editor, …)
  canAccess Boolean @default(true)
  @@unique([moduleId, role])
}

/// Catálogo de perfis de acesso da plataforma (Configurações → Perfis).
model PlatformRole {
  id                 String   @id @default(cuid())
  slug               String   @unique
  label              String
  sortOrder          Int      @default(0)
  /// Pode entrar no dashboard (login Cup360).
  canAccessDashboard Boolean  @default(true)
  /// Aparece na matriz Configurações → Acessos.
  includeInMatrix    Boolean  @default(true)
  /// Perfis do sistema — slug não pode ser alterado/apagado.
  isSystem           Boolean  @default(false)
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([sortOrder])
  @@index([isActive])
}

// Vault: itens com senha/segredos (sempre criptografados em repouso)
model VaultItem {
  id              String   @id @default(cuid())
  tenantId        String?  // null = grupo; preenchido = empresa
  title           String
  category        String   // ex: Email, Servidor, App
  username        String?
  url             String?
  encryptedSecret String   @db.Text
  encryptedNotes  String?  @db.Text
  iv              String   // IV para AES-GCM (hex)
  notesIv         String?  // IV para notes (hex)
  status          String   @default("active") // active | archived
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdBy       String?  // sub ou email do JWT
}

// Cadastros: campeonatos, estádios, times visitantes
model Championship {
  id                    String   @id @default(cuid())
  name                  String   @unique
  logoUrl               String?  // logo da competição (para tabela de classificação)
  standingsFormula      String?  // forma de cálculo: "pontos:desc,saldo_gols:desc,gols_marcados:desc"
  standingsFormulaName  String?  // nome da fórmula (só quando personalizado e não é preset)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model Stadium {
  id        String   @id @default(cuid())
  name      String   @unique
  city      String?
  country   String?
  address   String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VisitingTeam {
  id       String   @id @default(cuid())
  name     String   @unique
  logoUrl  String?  // pasta logos
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/** Categorias de futebol (Sub-17, Principal, etc.) — cadastro central do app */
model FixtureCategory {
  id        String   @id @default(cuid())
  value     String   @unique // slug interno: sub17, principal
  labelPT   String
  labelEN   String
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Jogadores (CRUD completo — dados base + médico, avaliações, status, desempenho)
model Player {
  id              String   @id @default(cuid())
  tenantId        String   // clube/empresa
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category        String?  // principal, sub20, sub17, sub15, feminino
  // Dados base (mesmos do Times por Categorias / Google Sheets)
  name            String
  photoUrl        String?
  birthDate       String?  // YYYY-MM-DD
  nationality     String?
  height          Int?     // cm
  weight          Int?     // kg
  /** Última vez que peso foi definido manualmente no cadastro; sync de fisiologia/nutrição só sobrescreve se medição for mais recente */
  weightManualAt  DateTime?
  /** Idem para altura */
  heightManualAt  DateTime?
  /** IMC e composição — valores atuais alinhados com fisiologia/nutrição (medição mais recente) */
  bmi             Float?
  bodyFatPercent  Float?
  leanMassKg      Float?
  bmiManualAt           DateTime?
  bodyFatPercentManualAt DateTime?
  leanMassManualAt      DateTime?
  preferredFoot   String?  // left, right, both
  jerseyNumber    Int?
  position        String?  // GK, CB, etc.
  fieldPositionX  Float?   // 0–100 posição no campo
  fieldPositionY  Float?
  currentTeam     String?
  previousTeams   Json?    // string[]
  seasonHistory   Json?    // PlayerSeasonHistory[]
  socialMedia     Json?    // PlayerSocialMedia
  matchesPlayed   Int?
  goals           Int?
  assists         Int?
  yellowCards     Int?
  redCards        Int?
  marketValue     Float?   // euros
  highlights      Json?    // string[] URLs
  bioPT           String?  @db.Text
  bioEN           String?  @db.Text
  externalId      String?  // ID da linha no Google Sheets (para sync)
  /** Registro oficial CBF, espelhado de registrationProfile.sports.cbf para vínculos externos */
  cbfRegistration String?
  // Contato (para envio do link da consulta por e-mail/WhatsApp)
  contactEmail    String?  // e-mail do atleta
  contactPhone    String?  // telefone/WhatsApp (ex: 5511999999999)
  emergencyContactName String?  // nome do contato/responsável em caso de emergência
  emergencyContactEmail String? // e-mail do contato/responsável
  emergencyContactPhone String? // telefone do contato/responsável
  // Extensões (histórico médico, avaliações, status, etc.)
  medicalHistory  Json?    // Array<{ date, type, description, daysOut, gamesMissed }>
  physiology      Json?    // { profile?: {}, records: PhysiologyEntry[] } — avaliações físicas (composição corporal, VO2, testes de campo)
  psychologicalAssessment Json?    // Array<{ date, evaluator, sections: anamnese psicológica esportiva }>
  onlineConsultations Json?    // Array<{ date, time?, type: meet, link?, notes?, status }>
  evaluations     Json?    // Array<{ date, evaluator, rating, notes }>
  status          String?  @default("available") // available, injured, suspended, absent, on_bench, not_in_squad
  statusDetails   String?  @db.Text // detalhes lesão/suspensão
  statusUntil     DateTime? // até quando (lesão/suspensão)
  heatMapData     Json?    // dados do mapa de calor
  performanceAnalysis String? @db.Text // análise de desempenho (texto livre ou JSON string)
  analysisMetrics Json?    // métricas estruturadas de scout: gols, assistências, xG, xA, passes-chave, duelos, etc. (totais ou por 90)
  images          Json?    // Array<{ type, url }> fotos de apoio
  publicFields    Json?    // quais campos exibir na página pública: { medicalHistory, evaluations, status, marketValue, performanceAnalysis, images, highlights }
  /** Cadastro estendido: dados pessoais, endereço, extras, características, rouparia, etc. */
  registrationProfile Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  legalDocuments  LegalDocument[]
  assignedAssets  Asset[]  // uniformes/kit atribuídos ao jogador
  nutritionAssessments NutritionAssessment[]
  nutritionAnamneses   NutritionAnamnesis[]
  supplementGuides     SupplementGuide[]  // guias de suplementação específicos do jogador
  guardians            PlayerGuardian[]
  schoolEnrollments    PlayerSchoolEnrollment[]
  socialPedagogyCases  SocialPedagogyCase[]
  socialPedagogyDocuments SocialPedagogyDocument[]
  rhEmployee           Employee?
  registrationInvites  RegistrationInvite[]
  agendaParticipations FootballAgendaEntryParticipant[]
  travelParticipations TravelParticipant[]
  scoutingProspects    ScoutingProspect[]
  physioSessions       PhysioSession[]
  physioTransitionPrograms PhysioTransitionProgram[]
  physioGameAttendances PhysioGameAttendance[]
  physioPlayerEvaluations PhysioPlayerEvaluation[]
  physioTryoutClearances PhysioTryoutClearance[]
  fmfMatchStats        FmfPlayerMatchStat[]
  disciplineOpenings   PlayerDisciplineOpening[]
  matchOfficialEvents  MatchOfficialEvent[]
  coachMatchPlayerRatings CoachMatchReportPlayerRating[]
  coachTeamReportPlayerActions CoachTeamReportPlayerAction[]
  coachTeamReportPlayerEvaluations CoachTeamReportPlayerEvaluation[]
  coachPlayerEvaluations           CoachPlayerEvaluation[]
  coachTrainingPlayerEntries CoachTrainingPlayerEntry[]
  physiologyAssessments      PhysiologyAssessment[]
  physiologyHydrations       PhysiologyHydration[]
  physiologyLoadEntries      PhysiologyLoadEntry[]
  nursingSessions            NursingSession[]
  medicalDepartures          PlayerMedicalDeparture[]
  @@index([tenantId])
  @@index([tenantId, category])
  @@index([tenantId, cbfRegistration])
}

/** Súmula oficial de uma partida importada da FMF. */
model FmfMatchReport {
  id                  String   @id @default(cuid())
  tenantId            String
  tenant              Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  externalMatchId     String   // ID do arquivo no SGE/FMF, ex.: 44855
  sourceUrl           String
  competition         String
  phase               String?
  round               Int?
  category            String
  season              Int
  matchDate           DateTime
  kickoffTime         String?
  homeTeam            String
  awayTeam            String
  homeScore           Int?
  awayScore           Int?
  firstHalfMinutes    Int?
  secondHalfMinutes   Int?
  totalMinutes        Int?
  rawParsed           Json?
  unresolvedPlayers   Json?
  /** Texto bruto da seção Ocorrências / Observações da súmula FMF. */
  occurrencesText     String?  @db.Text
  /** synced | warnings | unresolved | failed */
  integrityStatus     String?
  integrityCheckedAt  DateTime?
  integritySummary    Json?
  importedAt          DateTime @default(now())
  updatedAt           DateTime @updatedAt
  playerStats         FmfPlayerMatchStat[]
  matchOfficialEvents MatchOfficialEvent[]
  coachMatchReport    CoachMatchReport?
  coachStatOverride   CoachMatchStatOverride?
  matchIncidents      FootballMatchIncident[]
  matchAttachments    FootballMatchAttachment[]

  @@unique([tenantId, externalMatchId])
  @@index([tenantId, season, category])
  @@index([tenantId, matchDate])
}

/** Evento oficial normalizado de uma súmula FMF (gol, cartão, substituição, etc.). */
model MatchOfficialEvent {
  id                   String         @id @default(cuid())
  tenantId             String
  tenant               Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fmfMatchReportId     String
  fmfMatchReport       FmfMatchReport @relation(fields: [fmfMatchReportId], references: [id], onDelete: Cascade)
  factType             String
  provenance           String         @default("fmf_official")
  playerId             String?
  player               Player?        @relation(fields: [playerId], references: [id], onDelete: SetNull)
  technicalStaffId     String?
  technicalStaff       TechnicalStaff? @relation(fields: [technicalStaffId], references: [id], onDelete: SetNull)
  /** resolved | unresolved | ambiguous */
  resolutionStatus     String
  resolutionReason     String?
  sourceName           String?
  sourceRegistration   String?
  sourceJerseyNumber   Int?
  relatedJerseyNumber  Int?
  relatedPlayerId      String?
  sourceRoleLabel      String?
  sourceTeamSide       String?
  minute               Int?
  period               String?
  /** Relógio oficial HH:MM da súmula (preserva acréscimo, ex.: 47:00). */
  sourceClock          String?
  /** Ordem determinística dentro da partida (periodo → relógio → sequência na fonte). */
  sourceSequence       Int?
  goalType             String?
  sourceExcerpt        String?        @db.Text
  sourceSections       Json?
  /** Resolução do jogador que entra — relevante em PLAYER_SUBSTITUTION (saída em resolutionStatus). */
  relatedResolutionStatus String?
  externalKey          String
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  @@unique([fmfMatchReportId, externalKey])
  @@index([tenantId])
  @@index([fmfMatchReportId])
  @@index([playerId])
  @@index([technicalStaffId])
  @@index([factType])
}

/** Estatística oficial de um atleta em uma súmula FMF, sempre vinculada ao Player. */
model FmfPlayerMatchStat {
  id              String         @id @default(cuid())
  matchId         String
  match           FmfMatchReport @relation(fields: [matchId], references: [id], onDelete: Cascade)
  playerId        String
  player           Player         @relation(fields: [playerId], references: [id], onDelete: Cascade)
  cbfRegistration String
  playerName      String
  jerseyNumber    Int?
  starter         Boolean        @default(false)
  listed          Boolean        @default(true)
  played          Boolean        @default(false)
  enteredMinute   Int?
  exitedMinute    Int?
  minutesPlayed   Int            @default(0)
  goals           Int            @default(0)
  ownGoals        Int            @default(0)
  penaltyGoals    Int            @default(0)
  yellowCards     Int            @default(0)
  redCards        Int            @default(0)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@unique([matchId, playerId])
  @@index([playerId])
  @@index([playerId, matchId])
  @@index([cbfRegistration])
}

/** Saldo disciplinar de entrada na competição (transferência / clube anterior). */
model PlayerDisciplineOpening {
  id                   String   @id @default(cuid())
  tenantId             String
  tenant               Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  playerId             String
  player               Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  /** Chave canônica (normalizeCompetitionKey). */
  competitionKey       String
  /** Rótulo da competição (FMF/planilha). */
  competition          String
  season               Int
  effectiveFrom        DateTime @db.Date
  yellowAccum          Int      @default(0)
  suspensionRoundsLeft Int      @default(0)
  source               String   @default("manual")
  notes                String?  @db.Text
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([tenantId, playerId, competitionKey, season])
  @@index([tenantId, competitionKey, season])
  @@index([playerId])
}

/** Link público para atleta/colaborador completar cadastro (token único, expiração opcional) */
model RegistrationInvite {
  id              String    @id @default(cuid())
  token           String    @unique
  tenantId        String
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subjectType     String    // player | employee
  playerId        String?
  player          Player?   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  employeeId      String?
  employee        Employee? @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  expiresAt         DateTime?
  completedAt       DateTime?
  /** pending | approved | rejected — fluxo de aprovação RH */
  reviewStatus      String?
  submittedPayload  Json?
  submittedDocuments Json?
  submittedAt       DateTime?
  reviewedAt        DateTime?
  reviewedByUserId  String?
  rejectionReason   String?   @db.Text
  createdByUserId   String?
  createdAt         DateTime  @default(now())
  @@index([token])
  @@index([playerId])
  @@index([employeeId])
  @@index([tenantId])
  @@index([reviewStatus])
}

model LegalDocument {
  id               String    @id @default(cuid())
  playerId         String
  player           Player    @relation(fields: [playerId], references: [id], onDelete: Cascade)
  type             String    // contrato_trabalho, contrato_imagem, formacao, rescisao, transferencia, aditivo, procuração, nda, outro
  name             String    // nome exibido do documento
  fileKey          String    // key no S3 do PDF original
  fileUrl          String?   // URL pública (ou via proxy)
  signedFileKey    String?   // key no S3 do PDF assinado (após Adobe Sign)
  signedFileUrl    String?
  status           String    @default("draft") // draft, pending_signature, signed, expired, cancelled
  adobeAgreementId String?   // ID do agreement no Adobe Sign
  signerEmail      String?   // email de quem assina
  signerName       String?
  validFrom        DateTime? // vigência inicial
  validUntil       DateTime? // vigência até
  pageCount        Int?      // número de páginas do PDF
  notes            String?   @db.Text
  metadata         Json?     // dados extras
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  compensationItems EmploymentCompensationItem[]
  @@index([playerId])
  @@index([status])
  @@index([adobeAgreementId])
}

// Comissão técnica (treinador, auxiliar, preparador físico, médico, etc.)
model TechnicalStaff {
  id                String    @id @default(cuid())
  tenantId          String
  tenant            Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name              String
  photoUrl          String?
  role              String    // tecnico, auxiliar_tecnico, treinador_goleiros, preparador_fisico, medico, fisioterapeuta, fisiologista, psicologo, nutricionista, analista_desempenho, scout, massagista, enfermeiro, outro
  jobRoleId         String?
  jobRole           JobRole?  @relation(fields: [jobRoleId], references: [id], onDelete: SetNull)
  categories        Json?    // categorias que atende: ["principal","sub20","sub17"] — null = todas
  birthDate         String?   // YYYY-MM-DD
  nationality       String?
  cpf               String?
  rg                String?
  email             String?
  phone             String?
  address           String?   @db.Text
  licenseType       String?   // CBF Licença A/B/C, CREF, CRM, CRP, etc.
  licenseNumber     String?
  licenseValidUntil DateTime?
  contractType      String?   // CLT, PJ, estágio
  contractStart     DateTime?
  contractEnd       DateTime?
  bio               String?   @db.Text
  notes             String?   @db.Text
  psychologicalAssessment Json? // histórico clínico psicológico (comissão)
  onlineConsultations Json?    // consultas online Meet
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  scoutProfile         Scout?
  travelParticipations TravelParticipant[]
  coachMatchReports    CoachMatchReport[]
  coachTeamReports     CoachTeamReport[]
  coachTrainingSessions CoachTrainingSession[]
  matchOfficialEvents   MatchOfficialEvent[]
  @@index([tenantId])
  @@index([jobRoleId])
  @@index([tenantId, role])
}

// Cadastro de médicos/enfermeiros/fisioterapeutas (Depto Médico) — popula seleção em atendimentos
model MedicalStaff {
  id              String   @id @default(cuid())
  tenantId        String?
  tenant          Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  name            String
  role            String   // medico, enfermeiro, enfermeiro_tec, fisioterapeuta, nutricionista, fisiologista, massagista, outro
  crmCoren        String?  // CRM (médico), COREN (enfermeiro), CREF (fisio), CRN (nutri), etc.
  specialty       String?  // Especialidade (ex: ortopedia, cardiologia, enfermagem esportiva)
  photoUrl        String?
  birthDate       String?  // YYYY-MM-DD
  cpf             String?
  rg              String?
  email           String?
  phone           String?
  address         String?  @db.Text
  bio             String?  @db.Text
  notes           String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  @@index([tenantId])
  @@index([tenantId, role])
}

/// Estagiários do Depto Saúde / futebol — cadastro único com área de atuação
model HealthIntern {
  id             String        @id @default(cuid())
  tenantId       String?
  tenant         Tenant?       @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  name           String
  /// medicina | psicologia | fisioterapia | enfermagem | nutricao | fisiologia | massagem | outro
  area           String
  photoUrl       String?
  email          String?
  phone          String?
  registry       String?       // matrícula / registro acadêmico
  bio            String?       @db.Text
  notes          String?       @db.Text
  supervisorId   String?       // psicóloga(o) supervisora — área psicologia
  supervisor     Psychologist? @relation("HealthInternSupervision", fields: [supervisorId], references: [id], onDelete: SetNull)
  active         Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  @@index([tenantId])
  @@index([area])
  @@index([active])
  @@index([name])
  @@index([supervisorId])
}

/// Árbitros oficiais (cadastro com foto para Press Kit / relatórios)
model MatchReferee {
  id             String   @id @default(cuid())
  name           String
  photoUrl       String?
  federation     String?  // CBF, FMF, etc.
  licenseNumber  String?
  phone          String?
  email          String?
  notes          String?  @db.Text
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  @@index([name])
  @@index([active])
}

// Cadastro de psicólogos (Depto Saúde / Psicologia) — estagiários ficam em HealthIntern
model Psychologist {
  id                String   @id @default(cuid())
  name              String
  email             String?
  phone             String?
  crpOrEquivalent   String?  // Registro profissional (ex.: CRP)
  bio               String?  @db.Text
  photoUrl          String?
  tenantId          String?  // null = atende todos os clubes/empresas do grupo
  tenant            Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  staffRole         String   @default("psicologo") // legado: psicologo | estagiario (novos só psicologo)
  supervisorId      String?
  supervisor        Psychologist?  @relation("PsychologistSupervision", fields: [supervisorId], references: [id], onDelete: SetNull)
  supervisees       Psychologist[] @relation("PsychologistSupervision")
  supervisedInterns HealthIntern[] @relation("HealthInternSupervision")
  categories        Json?    // string[] — categorias que acompanha
  calendarBlocked   Boolean  @default(false)
  attendanceLog     Json?    // Array<{ date, startTime?, endTime?, playerId?, playerName?, notes? }>
  performanceSheet  Json?    // { summary?, metrics?, notes?, updatedAt? }
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  @@index([tenantId])
  @@index([staffRole])
}

/// Sessões de psicologia: presencial, grupo e relatório semanal — integradas à agenda do clube
model PsychologySession {
  id                    String   @id @default(cuid())
  tenantId              String
  tenant                Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sessionType           String   // presencial | grupo | relatorio_semanal
  date                  String
  time                  String?
  endTime               String?
  category              String?
  playerId              String?
  /// player | employee | staff — destinatário do atendimento presencial
  personType            String?  @default("player")
  employeeId            String?
  staffId               String?
  /// elenco | emprestado | funcionario
  personClassification  String?
  psychologistId        String?
  estagiarioId          String?
  psychologistName      String?
  estagiarioName        String?
  location              String?
  status                String   @default("scheduled") // scheduled | completed | cancelled
  notes                 String?  @db.Text
  periodStart           String?
  periodEnd             String?
  categoriesLabel       String?
  activities            String?  @db.Text
  individualDemands     String?  @db.Text
  weeklyDevelopment     String?  @db.Text
  identifiedDemands     String?  @db.Text
  nextWeekPlanning      String?  @db.Text
  finalSummary          String?  @db.Text
  generalNotes          String?  @db.Text
  groupSummary          String?  @db.Text
  attendance            Json?    // [{ playerId, playerName, present, individualNotes? }]
  footballAgendaEntryId String?
  /// Quando true, não aparece na Agenda Geral (só na Agenda Psicologia)
  isPrivate             Boolean  @default(false)
  durationSeconds       Int?
  /// [{ at, userId, userName, action, comment? }]
  editLog               Json?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  @@index([tenantId, date])
  @@index([sessionType])
}

/// Material de apoio da psicologia (PDFs, imagens, planilhas) — biblioteca compartilhada da equipe
model PsychologySupportMaterial {
  id            String   @id @default(cuid())
  title         String
  description   String?  @db.Text
  category      String?  // protocolo | material | apresentacao | formulario | outro
  fileKey       String
  fileUrl       String
  fileName      String
  mimeType      String?
  fileSizeBytes Int?
  tenantId      String?
  tenant        Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  uploadedBy    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  @@index([tenantId])
  @@index([createdAt])
}

// Integrações centralizadas (planilhas Google únicas) — uma planilha por tipo, sistema filtra por slug
model IntegrationConfig {
  id        String   @id @default(cuid())
  key       String   @unique // times_categorias | proximos_jogos | tabela_classificacao
  config    Json     // { spreadsheetUrl, gid }
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Auditoria do Vault (nunca logar o secret)
model VaultAuditLog {
  id          String   @id @default(cuid())
  action      String   // VIEW_LIST | VIEW_DETAILS | REVEAL_SECRET | COPY_SECRET | CREATE | UPDATE | DELETE
  performedBy String
  itemId      String?
  details     String?  @db.Text
  createdAt   DateTime @default(now())
}

// ========== DEPARTAMENTO DE COMPRAS (Adm) ==========
// Fornecedor (por tenant/clube)
model Supplier {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  document    String?  // CPF/CNPJ
  contactName String?
  email       String?
  phone       String?
  notes       String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  purchaseOrders PurchaseOrder[]
  quotes         PurchaseQuote[]
  financeiroLancamentos FinanceiroLancamento[]
  @@index([tenantId])
}

// Produto/catálogo (estoque por tenant) — estoque mínimo gera alerta
model Product {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name          String
  sku           String?  // código interno
  unit          String   @default("un") // un, cx, kg, etc.
  stockMin      Int      @default(0)   // abaixo disso = alerta
  currentStock  Int      @default(0)
  /// Categoria ADM de compras (alimentacao, uniforme_futebol, produtos_limpeza, …)
  inventoryKind String   @default("uso_consumo")
  /// Preço da última compra / entrada (R$)
  purchasePrice Decimal? @db.Decimal(12, 2)
  /// Preço unitário atual (última entrada)
  currentPrice  Decimal? @db.Decimal(12, 2)
  /// Preço médio ponderado das entradas
  averagePrice  Decimal? @db.Decimal(12, 2)
  /// Categorias de futebol do clube (ex.: principal, sub20) — null ou [] = vale para todas
  squadTags     Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  stockMovements StockMovement[]
  nursingTreatments NursingTreatment[]
  nursingSessionTreatments NursingSessionTreatment[]
  @@index([tenantId])
  @@index([tenantId, currentStock])
  @@index([tenantId, inventoryKind])
}

/// Categoria de produto (Compras / Estoque) — sistema + customizadas por clube
model InventoryCategory {
  id        String   @id @default(cuid())
  tenantId  String?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  slug      String
  name      String
  sortOrder Int      @default(0)
  isSystem  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([tenantId])
  @@index([slug])
  @@index([isSystem])
}

// Requisição de compra — solicitante, itens, cotações, aprovações
model PurchaseRequisition {
  id                String   @id @default(cuid())
  tenantId          String
  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  requestedByUserId String?
  requestedByName   String
  requestedAt       DateTime @default(now())
  requestType       String   @default("compra") // compra | ti
  departmentName    String?
  status            String   @default("rascunho")
  justification     String?  @db.Text
  items             Json     // [{ productId?, description, quantity, unit, estimatedUnitPrice?, isPatrimonial? }]
  totalEstimated    Float?
  approvedTotal     Float?
  selectedQuoteId   String?  @unique
  selectedQuote     PurchaseQuote? @relation("SelectedQuote", fields: [selectedQuoteId], references: [id], onDelete: SetNull)
  isPatrimonial     Boolean  @default(false)
  rejectionReason   String?  @db.Text
  requesterEmail    String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  quotes            PurchaseQuote[] @relation("RequisitionQuotes")
  approvals         PurchaseApproval[]
  receipt           PurchaseReceipt?
  purchaseOrders    PurchaseOrder[]
  assets            Asset[]
  @@index([tenantId])
  @@index([status])
  @@index([requestedByUserId])
  @@index([requestType])
}

model PurchaseQuote {
  id             String   @id @default(cuid())
  requisitionId  String
  requisition    PurchaseRequisition @relation("RequisitionQuotes", fields: [requisitionId], references: [id], onDelete: Cascade)
  supplierId     String?
  supplier       Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  supplierName   String
  items          Json     // [{ description, quantity, unit, unitPrice }]
  totalAmount    Float
  deliveryDays   Int?
  notes          String?  @db.Text
  attachmentUrl  String?
  isWinner       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  selectedFor    PurchaseRequisition? @relation("SelectedQuote")
  purchaseOrders PurchaseOrder[]
  @@index([requisitionId])
  @@index([supplierId])
}

model PurchaseApproval {
  id            String   @id @default(cuid())
  requisitionId String
  requisition   PurchaseRequisition @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  role          String   // financeiro | diretoria
  approverUserId String?
  approverName  String
  decision      String   // approved | rejected
  notes         String?  @db.Text
  decidedAt     DateTime @default(now())
  @@index([requisitionId])
  @@index([role])
}

model PurchaseSetting {
  id                    String   @id @default(cuid())
  tenantId              String   @unique
  tenant                Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  approvalThresholdBrl  Float    @default(5000)
  minQuotes             Int      @default(2)
  maxQuotes             Int      @default(4)
  comprasNotifyEmail    String?
  comprasNotifyPhone    String?
  financeiroNotifyEmail String?
  financeiroNotifyPhone String?
  tiNotifyEmail         String?
  tiNotifyPhone         String?
  diretoriaNotifyEmail  String?
  diretoriaNotifyPhone  String?
  updatedAt             DateTime @updatedAt
}

model PurchaseReceipt {
  id                 String   @id @default(cuid())
  requisitionId      String   @unique
  requisition        PurchaseRequisition @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  receivedAt         DateTime @default(now())
  receivedByName     String?
  signerEmail        String?
  signerName         String?
  helloSignRequestId String?
  signatureStatus    String   @default("pending") // pending | sent | signed
  signedAt           DateTime?
  metadata           Json?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model TiSupportTicket {
  id                String   @id @default(cuid())
  tenantId          String
  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  requestedByUserId String?
  requestedByName   String
  subject           String
  description       String?  @db.Text
  priority          String   @default("normal") // baixa | normal | alta | urgente
  status            String   @default("aberto") // aberto | em_atendimento | resolvido | fechado
  assignedToName    String?
  resolutionNotes   String?  @db.Text
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  @@index([tenantId])
  @@index([status])
}

// Ordem de compra — vinculada a fornecedor (e opcionalmente à requisição)
model PurchaseOrder {
  id               String   @id @default(cuid())
  tenantId         String
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  requisitionId    String?
  requisition      PurchaseRequisition? @relation(fields: [requisitionId], references: [id], onDelete: SetNull)
  quoteId          String?
  quote            PurchaseQuote? @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  supplierId       String
  supplier         Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  orderNumber      String?  // número da OP
  orderedAt        DateTime @default(now())
  status           String   @default("draft") // draft | sent | approved | received | cancelled
  items            Json     // [{ productId?, description, quantity, unitPrice }]
  totalAmount      Float?
  expectedDelivery DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  @@index([tenantId])
  @@index([supplierId])
  @@index([requisitionId])
  @@index([quoteId])
}

// Movimentação de estoque — entrada (compra), saída (requisição), ajuste
model StockMovement {
  id            String   @id @default(cuid())
  productId     String
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity      Int      // positivo = entrada, negativo = saída
  type          String   // purchase | requisition | adjustment
  unitPrice     Decimal? @db.Decimal(12, 2)
  referenceType String?  // order | requisition
  referenceId   String?
  notes         String?  @db.Text
  createdAt     DateTime @default(now())
  @@index([productId])
  @@index([createdAt])
}

// ========== RH (Departamento de Futebol / Adm) ==========

model Department {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name       String
  code       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  jobRoles   JobRole[]
  employments Employment[]
  @@index([tenantId])
}

model JobRole {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  name         String
  code         String?
  type         String   // staff | athlete
  /** Aparece em Cadastros do Futebol → Funções e no dropdown da comissão */
  forFootball  Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  employments  Employment[]
  technicalStaff TechnicalStaff[]
  @@index([tenantId])
  @@index([departmentId])
  @@index([forFootball])
}

model Employee {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /** Matrícula RH legível (ex.: BCF-000042) — única por tenant */
  code       String?
  name       String
  cpf        String?
  rg         String?
  email      String?
  phone      String?
  birthDate  DateTime?
  type       String   // staff | athlete | dirigente | temporario | estagio
  categories Json?    // atleta: ["sub20","profissional","sub17"]
  notes      String?  @db.Text
  photoUrl   String?
  /** Endereço: { street, number, complement, neighborhood, city, state, zipCode } */
  address    Json?
  pisNumber  String?
  voterTitle String?
  ctpsUrl    String?
  pixKey     String?
  admissionMedicalExamDate     DateTime?
  admissionMedicalExamFileUrl  String?
  dismissalMedicalExamDate     DateTime?
  dismissalMedicalExamFileUrl  String?
  hasMinorChildren             Boolean  @default(false)
  psychologicalAssessment Json?
  onlineConsultations Json?
  /** Cadastro operacional Futebol (atleta/comissão) — evita duplicidade de pessoa */
  playerId   String?  @unique
  player     Player?  @relation(fields: [playerId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  employments Employment[]
  documents  EmployeeDocument[]
  dependents EmployeeDependent[]
  registrationInvites RegistrationInvite[]
  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([tenantId, type])
  @@index([playerId])
}

model Employment {
  id                    String   @id @default(cuid())
  tenantId              String
  tenant                Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employeeId            String
  employee              Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  jobRoleId             String
  jobRole               JobRole  @relation(fields: [jobRoleId], references: [id], onDelete: Restrict)
  departmentId          String?
  department            Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  contractType          String   // CLT | PJ | estagio | atleta
  startDate             DateTime
  endDate               DateTime?
  salaryBase            Float?
  /** { bank, agency, account, accountType?, operation?, pix?, pixKeyType?, holderName?, holderCpf? } */
  bankData              Json?
  status                String   @default("ativo") // ativo | afastado | desligado
  notes                 String?  @db.Text
  athleteData           Json?    // { numeroRegistroCBF, dataValidadeContrato, clausulaPenal? }
  admissionChecklist    Json?    // [{ key, label, status, completedAt?, notes }]
  terminationType       String?  // sem_justa_causa | justa_causa | pedido_demissao | fim_contrato
  terminationNotes      String?  @db.Text
  terminationChecklist  Json?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  leavePeriods          LeavePeriod[]
  contracts             EmploymentContract[]
  compensationItems     EmploymentCompensationItem[]
  salaryRevisions       EmploymentSalaryRevision[]
  @@index([tenantId])
  @@index([employeeId])
  @@index([status])
}

/** Benefício / ajuda de custo / direito de imagem — valor mensal com vigência */
model EmploymentCompensationItem {
  id              String         @id @default(cuid())
  tenantId        String
  tenant          Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employmentId    String
  employment      Employment     @relation(fields: [employmentId], references: [id], onDelete: Cascade)
  /// TRANSPORT | MEAL | COST_ALLOWANCE | IMAGE_RIGHTS
  kind            String
  amount          Decimal        @db.Decimal(12, 2)
  effectiveFrom   DateTime
  effectiveTo     DateTime?
  legalDocumentId String?
  legalDocument   LegalDocument? @relation(fields: [legalDocumentId], references: [id], onDelete: SetNull)
  notes           String?        @db.Text
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  @@index([tenantId])
  @@index([employmentId])
  @@index([employmentId, kind])
  @@index([employmentId, kind, effectiveFrom])
}

/** Histórico salarial efetivo — Employment.salaryBase permanece o valor corrente */
model EmploymentSalaryRevision {
  id            String     @id @default(cuid())
  tenantId      String
  tenant        Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employmentId  String
  employment    Employment @relation(fields: [employmentId], references: [id], onDelete: Cascade)
  amount        Decimal    @db.Decimal(12, 2)
  effectiveFrom DateTime
  effectiveTo   DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  @@index([tenantId])
  @@index([employmentId])
  @@index([employmentId, effectiveFrom])
}

model EmployeeDocument {
  id           String   @id @default(cuid())
  employeeId   String
  employee     Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  employmentId String?
  documentType String   // RG, CPF, CTPS, reservista, contrato, exame_admissional, exame_demissional, atestado
  fileKey      String?
  fileUrl      String?
  validUntil   DateTime?
  notes        String?  @db.Text
  createdAt    DateTime @default(now())
  @@index([employeeId])
}

/** Filhos menores de 14 anos (documentação salário-família / eSocial) */
model EmployeeDependent {
  id                      String   @id @default(cuid())
  employeeId              String
  employee                Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  name                    String
  birthDate               DateTime
  birthCertificateFileUrl String?
  schoolAttendanceFileUrl String?
  vaccinationCardFileUrl  String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  @@index([employeeId])
}

model LeavePeriod {
  id           String   @id @default(cuid())
  employmentId String
  employment   Employment @relation(fields: [employmentId], references: [id], onDelete: Cascade)
  type         String   // vacation | sick_leave | maternity | accident | other
  startDate    DateTime
  endDate      DateTime
  documentRef  String?
  catNumber    String?
  notes        String?  @db.Text
  status       String   @default("planned") // planned | approved | in_progress | completed | cancelled
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  @@index([employmentId])
  @@index([type])
}

/** Modelo de contrato base (Depto Jurídico) — PDF com campos AcroForm preenchíveis pelo RH. */
model ContractTemplate {
  id             String   @id @default(cuid())
  tenantId       String?
  tenant         Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name           String
  type           String   // contrato_trabalho, contrato_imagem, CLT, PJ, estagio, atleta, etc.
  fileKey        String
  fileUrl        String?
  pdfFieldNames  Json?    // ["nome_completo","cpf",...] detectados no upload
  fieldMapping   Json?    // { "nome_completo": "employee.name", "cpf": "employee.cpf" }
  signaturePage  Int      @default(1)
  pageCount      Int?
  active         Boolean  @default(true)
  notes          String?  @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  contracts      EmploymentContract[]
  @@index([tenantId])
  @@index([type])
  @@index([active])
}

/** Instância de contrato gerada no vínculo RH (PDF preenchido + assinatura). */
model EmploymentContract {
  id                   String           @id @default(cuid())
  tenantId             String
  tenant               Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employmentId         String
  employment           Employment       @relation(fields: [employmentId], references: [id], onDelete: Cascade)
  templateId           String
  template             ContractTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)
  name                 String
  fileKey              String
  fileUrl              String?
  signedFileKey        String?
  signedFileUrl        String?
  status               String           @default("draft") // draft | pending_signature | signed | expired | cancelled
  helloSignRequestId   String?
  signerEmail          String?
  signerName           String?
  metadata             Json?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  @@index([tenantId])
  @@index([employmentId])
  @@index([templateId])
  @@index([status])
}

// ========== Patrimônio (empresa + clube; clube tem kit: camisa, calção, meião) ==========

model AssetCategory {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String   // ex.: Móveis, Equipamentos, Veículos, Kit uniforme
  code      String?  // código opcional (ex.: MOV, EQU, KIT)
  kind      String   @default("general") // general | uniform (uniform = exibe campos camisa/calção/meião)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  assets    Asset[]
  @@index([tenantId])
}

model Asset {
  id                String         @id @default(cuid())
  tenantId          String
  tenant            Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  categoryId        String
  category          AssetCategory  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  tagNumber         String?        // número da etiqueta patrimonial (bens gerais)
  description       String         // descrição do bem
  location          String?        // setor/local onde está
  responsibleName   String?       // nome do responsável (ou futuramente FK User)
  acquisitionDate   DateTime?     // data de aquisição
  acquisitionValue  Float?         // valor de aquisição (R$)
  depreciationRate  Float?         // taxa de depreciação anual (%)
  status            String         @default("em_uso") // em_uso | em_manutencao | emprestado | baixado
  notes             String?        @db.Text
  // Campos para kit uniforme (quando category.kind = uniform)
  pieceType         String?        // camisa | calção | meião
  size              String?       // P, M, G, GG, etc.
  shirtNumber       Int?           // número da camisa (1-99)
  assignedPlayerId  String?       // jogador com o item (só para clubes)
  assignedPlayer    Player?       @relation(fields: [assignedPlayerId], references: [id], onDelete: SetNull)
  purchaseRequisitionId String?
  purchaseRequisition   PurchaseRequisition? @relation(fields: [purchaseRequisitionId], references: [id], onDelete: SetNull)
  purchaseOrderId   String?
  photoUrl          String?        // foto registrada do bem (URL da mídia / proxy)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  infrastructureProfile AssetInfrastructureProfile?
  topologyLinksFrom AssetTopologyLink[] @relation("TopologyFrom")
  topologyLinksTo   AssetTopologyLink[] @relation("TopologyTo")
  backboneFibers    AssetBackboneFiber[]
  @@index([tenantId])
  @@index([categoryId])
  @@index([status])
  @@index([assignedPlayerId])
  @@index([tenantId, pieceType])
}

// ========== Infraestrutura TI (extensão técnica do Patrimônio — sem duplicar bens) ==========

model InfrastructureRack {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  location  String?
  totalUnits Int     @default(42)
  notes     String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  profiles  AssetInfrastructureProfile[]
  @@index([tenantId])
}

model AssetInfrastructureProfile {
  id               String   @id @default(cuid())
  assetId          String   @unique
  asset            Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  hostname         String?
  identity         String?
  ipAddress        String?
  subnetMask       String?
  gateway          String?
  dns              String?
  macAddress       String?
  operatingSystem  String?
  firmware         String?
  version          String?
  manufacturer     String?
  model            String?
  serialNumber     String?
  rackId           String?
  rack             InfrastructureRack? @relation(fields: [rackId], references: [id], onDelete: SetNull)
  rackPositionU    Int?
  rackSide         String?  // frente | traseira
  infraStatus      String?  // operacional | manutencao | reserva | desativado
  vlan             String?
  bridge           String?
  bond             String?
  technicalNotes   String?  @db.Text
  monitoringNotes  String?  @db.Text
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  interfaces       AssetNetworkInterface[]
  documents        AssetInfrastructureDocument[]
  backups          AssetInfrastructureBackup[]
  credentials      AssetInfrastructureCredential[]
  softwareInstalls AssetSoftwareInstall[]
  disasterRecovery AssetDisasterRecoveryPlan?
  auditLogs        AssetInfrastructureAuditLog[]
  @@index([rackId])
}

model AssetNetworkInterface {
  id          String   @id @default(cuid())
  profileId   String
  profile     AssetInfrastructureProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  name        String
  type        String   // ethernet | sfp | qsfp | fiber | dac | loopback | bridge | wireless
  speed       String?
  status      String?  // up | down | disabled
  description String?
  connectedTo String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([profileId])
}

model AssetTopologyLink {
  id              String   @id @default(cuid())
  tenantId        String
  sourceAssetId   String
  sourceAsset     Asset    @relation("TopologyFrom", fields: [sourceAssetId], references: [id], onDelete: Cascade)
  targetAssetId   String
  targetAsset     Asset    @relation("TopologyTo", fields: [targetAssetId], references: [id], onDelete: Cascade)
  connectionType  String   // fibra | cat6 | dac | wireless | outro
  speed           String?
  length          String?
  notes           String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  @@index([tenantId])
  @@index([sourceAssetId])
  @@index([targetAssetId])
}

model AssetBackboneFiber {
  id              String   @id @default(cuid())
  tenantId        String
  origin          String
  destination     String
  equipmentAssetId String?
  equipmentAsset  Asset?   @relation(fields: [equipmentAssetId], references: [id], onDelete: SetNull)
  port            String?
  fiberType       String?
  speed           String?
  status          String?
  photoUrls       Json?
  notes           String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  @@index([tenantId])
  @@index([equipmentAssetId])
}

model AssetInfrastructureDocument {
  id          String   @id @default(cuid())
  profileId   String
  profile     AssetInfrastructureProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  name        String
  docType     String   // pdf | docx | dwg | routeros_backup | routeros_export | config | foto | diagrama | garantia | contrato | outro
  fileUrl     String?
  fileKey     String?
  uploadedBy  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([profileId])
}

model AssetInfrastructureBackup {
  id              String   @id @default(cuid())
  profileId       String
  profile         AssetInfrastructureProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  backupType      String   // routeros | windows | linux | docker | banco | config | outro
  fileUrl         String?
  fileKey         String?
  version         String?
  backupDate      DateTime?
  responsibleName String?
  comments        String?  @db.Text
  isCurrent       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  @@index([profileId])
}

model AssetInfrastructureCredential {
  id              String   @id @default(cuid())
  profileId       String
  profile         AssetInfrastructureProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  title           String
  username        String?
  secretEnc       String?  @db.Text
  secretIv        String?
  url             String?
  category        String?
  notes           String?  @db.Text
  lastChangedAt   DateTime?
  responsibleName String?
  vaultItemId     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  auditLogs       AssetInfrastructureCredentialAuditLog[]
  @@index([profileId])
}

model AssetInfrastructureCredentialAuditLog {
  id           String   @id @default(cuid())
  credentialId String
  credential   AssetInfrastructureCredential @relation(fields: [credentialId], references: [id], onDelete: Cascade)
  action       String   // VIEW | REVEAL | COPY | CREATE | UPDATE | DELETE
  performedBy  String
  details      String?
  createdAt    DateTime @default(now())
  @@index([credentialId])
}

model AssetSoftwareInstall {
  id           String   @id @default(cuid())
  profileId    String
  profile      AssetInfrastructureProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  name         String
  version      String?
  licenseKey   String?
  licenseRef   String?
  installedAt  DateTime?
  notes        String?  @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  @@index([profileId])
}

model AssetDisasterRecoveryPlan {
  id              String   @id @default(cuid())
  profileId       String   @unique
  profile         AssetInfrastructureProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  checklist       Json?
  procedure       String?  @db.Text
  estimatedTime   String?
  prerequisites   String?  @db.Text
  relatedFiles    Json?
  backupRefs      Json?
  notes           String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model AssetInfrastructureAuditLog {
  id          String   @id @default(cuid())
  profileId   String
  profile     AssetInfrastructureProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  performedBy String
  action      String
  changes     Json?
  notes       String?
  createdAt   DateTime @default(now())
  @@index([profileId])
}

// ========== Nutrição (clube: cardápios, calendário por categoria, avaliações) ==========

model NutritionCategory {
  id                  String   @id @default(cuid())
  tenantId            String
  tenant              Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name                String   // ex.: Sub-17, Profissional, Feminino
  code                String?  // ex.: sub17, pro
  dailyCaloriesTarget Int?     // meta calórica diária (kcal) para a categoria
  notes               String?  @db.Text
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  menus               NutritionMenu[]
  calendarEntries     NutritionCalendarEntry[]
  supplementGuides   SupplementGuide[]
  @@index([tenantId])
}

model NutritionMealType {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String   // ex.: Café da manhã, Almoço, Pré-jogo
  code      String   // cafe_manha, almoco, pre_jogo, pos_jogo, lanche_manha, lanche_tarde, jantar, ceia
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  menuItems NutritionMenuItem[]
  @@index([tenantId])
}

model NutritionMenu {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String   // ex.: Cardápio Semana 1 - Sub-17
  categoryId  String?  // categoria a que se aplica (null = geral)
  category    NutritionCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  dayContext  String?  // treino | jogo | folga
  validFrom   DateTime? // vigência início
  validTo     DateTime? // vigência fim
  notes       String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  items       NutritionMenuItem[]
  calendarEntries NutritionCalendarEntry[]
  @@index([tenantId])
  @@index([categoryId])
}

model NutritionMenuItem {
  id          String   @id @default(cuid())
  menuId      String
  menu        NutritionMenu @relation(fields: [menuId], references: [id], onDelete: Cascade)
  mealTypeId  String
  mealType    NutritionMealType @relation(fields: [mealTypeId], references: [id], onDelete: Restrict)
  description String   @db.Text // ex.: Arroz integral, frango grelhado, salada
  calories    Int?     // kcal
  proteinG    Float?   // gramas proteína
  carbsG      Float?   // gramas carboidrato
  fatsG       Float?   // gramas gordura
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([menuId])
  @@index([mealTypeId])
}

model NutritionCalendarEntry {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  categoryId String   // categoria (ex.: Sub-17)
  category   NutritionCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  date       DateTime // dia do calendário
  menuId     String   // cardápio a seguir nesse dia
  menu       NutritionMenu @relation(fields: [menuId], references: [id], onDelete: Restrict)
  dayContext String?  // treino | jogo | folga (opcional, pode vir do menu)
  notes      String?  @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  @@unique([tenantId, categoryId, date])
  @@index([tenantId])
  @@index([categoryId])
  @@index([date])
}

model NutritionAssessment {
  id              String   @id @default(cuid())
  playerId        String
  player          Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  assessedAt      DateTime // data da avaliação
  weightKg        Float    // peso (kg)
  heightCm        Float?   // estatura (cm)
  bmi             Float?   // IMC calculado
  bodyFatPercent  Float?   // % gordura corporal
  notes           String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  @@index([playerId])
  @@index([assessedAt])
}

model NutritionAnamnesis {
  id         String   @id @default(cuid())
  playerId   String
  player     Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  assessedAt DateTime
  data       Json     // campos da anamnese nutricional (ver nutricao-anamnesis.ts)
  notes      String?  @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  @@index([playerId])
  @@index([assessedAt])
}

model SupplementGuide {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  categoryId String?  // null = time todo
  category   NutritionCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  playerId   String?  // null = time ou categoria; preenchido = jogador específico (vem do cadastro)
  player     Player?  @relation(fields: [playerId], references: [id], onDelete: SetNull)
  name       String   // ex.: Whey protein, Creatina
  whenToTake String?  @db.Text // quando tomar (pré-treino, pós, etc.)
  notes      String?  @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  @@index([tenantId])
  @@index([categoryId])
  @@index([playerId])
}

// ========== Assistência Social / Pedagogia (futebol) ==========

model PlayerGuardian {
  id           String   @id @default(cuid())
  playerId     String
  player       Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  name         String
  relationship String   // pai | mae | tutor | responsavel | outro
  phone        String?
  email        String?
  cpf          String?
  address      Json?
  isPrimary    Boolean  @default(false)
  notes        String?  @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  @@index([playerId])
}

model PlayerSchoolEnrollment {
  id                String    @id @default(cuid())
  playerId          String
  player            Player    @relation(fields: [playerId], references: [id], onDelete: Cascade)
  schoolName        String
  grade             String?
  period            String?   // manha | tarde | integral | noturno
  shift             String?
  city              String?
  coordinatorName   String?
  coordinatorEmail  String?
  coordinatorPhone  String?
  schoolYear        String?
  simadeNumber      String?
  status            String    @default("ativo") // ativo | transferido | concluido
  startDate         DateTime?
  endDate           DateTime?
  notes             String?   @db.Text
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  @@index([playerId])
  @@index([status])
}

model SocialPedagogyCase {
  id                        String    @id @default(cuid())
  tenantId                  String
  tenant                    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  playerId                  String
  player                    Player    @relation(fields: [playerId], references: [id], onDelete: Cascade)
  triggerType               String    // horario_treino | convocacao | inicio_letivo | manual
  triggerLabel              String?
  triggerRefType            String?   // travel | agenda_entry | none
  triggerRefId              String?
  status                    String    @default("coleta") // coleta | agenda | comunicacao | documentos | concluido
  periodStart               DateTime?
  periodEnd                 DateTime?
  contactValidation         Json?
  agendaSnapshot            Json?
  schoolNotificationText    String?   @db.Text
  schoolNotificationSentAt  DateTime?
  schoolNotificationChannel String?
  schoolResponseNotes       String?   @db.Text
  notes                     String?   @db.Text
  createdByUserId           String?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt
  documents                 SocialPedagogyDocument[]
  @@index([tenantId])
  @@index([playerId])
  @@index([status])
  @@index([triggerType])
}

model SocialPedagogyDocument {
  id           String   @id @default(cuid())
  playerId     String
  player       Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  caseId       String?
  case         SocialPedagogyCase? @relation(fields: [caseId], references: [id], onDelete: SetNull)
  documentType String   // matricula | boletim | frequencia | dispensa | comprovante | parecer | outro
  name         String
  fileUrl      String
  schoolYear   String?
  period       String?
  receivedAt   DateTime?
  notes        String?  @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  @@index([playerId])
  @@index([caseId])
  @@index([documentType])
}

// ========== Sócio Torcedor (por clube) ==========

model SocioPlan {
  id             String   @id @default(cuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name           String   // ex.: Diamante, Ouro, Prata, Bronze
  slug           String   // ex.: diamante, ouro, prata
  description    String?  @db.Text // descrição do plano
  priceMonthly   Decimal  @db.Decimal(10, 2) // valor mensal
  perks          Json?    // { ticketDiscountPercent, merchandiseDiscountPercent, foodDiscountPercent, earlyTicketHours, stadiumTour, exclusiveContent, welcomePack, customPerks[] }
  sortOrder      Int      @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  members        SocioMember[]
  @@unique([tenantId, slug])
  @@index([tenantId])
}

model SocioMember {
  id           String    @id @default(cuid())
  tenantId     String
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  planId       String
  plan         SocioPlan @relation(fields: [planId], references: [id], onDelete: Restrict)
  name         String
  email        String
  phone        String?
  cpf          String?   // CPF para emissão de ingressos
  status       String    @default("active") // active | suspended | cancelled
  joinedAt     DateTime  @default(now())
  points       Int       @default(0) // pontos de fidelidade
  loyaltyTier  Int       @default(1) // 1-5 estrelas (antiguidade/engajamento)
  externalId   String?   // ID em sistema externo (gate de ingressos, etc.)
  notes        String?   @db.Text
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  @@index([tenantId])
  @@index([planId])
  @@index([status])
  @@index([tenantId, email])
}

/// Boston TV — sinalização digital interna (player em /tv/play/[token])
model BostonTvPlaylist {
  id          String   @id @default(cuid())
  tenantId  String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  /** landscape = horizontal (padrão) | portrait = vertical (TV em pé) */
  displayOrientation String @default("landscape")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  items       BostonTvPlaylistItem[]
  screens     BostonTvScreen[]
  hallChannel BostonTvHallChannel?

  @@index([tenantId])
}

/// Relógio mestre — telas com a mesma playlist seguem a mesma posição no loop.
model BostonTvHallChannel {
  id               String   @id @default(cuid())
  tenantId         String   @unique
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  playlistId       String   @unique
  playlist         BostonTvPlaylist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  /** Âncora UTC — elapsed = now - epochAt (quando não pausado). */
  epochAt          DateTime @default(now())
  isPaused         Boolean  @default(false)
  pausedElapsedMs  Int      @default(0)
  playlistVersion  Int      @default(1)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([playlistId])
}

model BostonTvPlaylistItem {
  id              String   @id @default(cuid())
  playlistId      String
  playlist        BostonTvPlaylist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  sortOrder       Int      @default(0)
  /** image_url | video_url | youtube_video | iptv_stream | vmix_stream */
  contentType     String
  url             String   @db.Text
  /** Imagem/slide: obrigatório (segundos na tela). Vídeo: opcional. */
  durationSeconds Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([playlistId])
}

model BostonTvIptvSource {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name         String   @default("IPTV")
  playlistUrl  String   @db.Text
  lastSyncedAt DateTime?
  channelCount Int      @default(0)
  /** idle | syncing | done | error */
  syncStatus   String   @default("idle")
  syncError    String?  @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  channels     BostonTvIptvChannel[]

  @@index([tenantId])
}

model BostonTvIptvChannel {
  id            String   @id @default(cuid())
  sourceId      String
  source        BostonTvIptvSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  name          String
  groupTitle    String?
  logoUrl       String?  @db.Text
  streamUrl     String   @db.Text
  streamUrlHash String
  tvgId         String?
  sortOrder     Int      @default(0)
  /** Liberado para escolha nas telas Boston TV */
  enabledForSelection Boolean @default(false)
  createdAt     DateTime @default(now())
  screens       BostonTvScreen[]

  @@unique([sourceId, streamUrlHash])
  @@index([sourceId])
  @@index([sourceId, name])
  @@index([sourceId, enabledForSelection])
}

model BostonTvVmixChannel {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  /** URL HLS (.m3u8) ou MPEG-TS publicada pelo vMix (Output → stream). */
  /** stream = URL HLS/TS | ndi = nome da fonte NDI na LAN (app nativo) */
  deliveryType   String   @default("stream")
  /** Ex.: "DESKTOP-ABC (vMix - Output 1)" — usado quando deliveryType = ndi */
  ndiSourceName  String?
  streamUrl String   @db.Text
  sortOrder Int      @default(0)
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

model BostonTvScreen {
  id               String   @id @default(cuid())
  tenantId         String
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name             String
  locationHint     String?
  /** Token secreto na URL pública do player */
  playerToken      String   @unique
  /** playlist = loop da playlist | iptv = canal fixo */
  displayMode      String   @default("playlist")
  /** follow_hall = sincronizado no Canal Hall | independent = playlist só desta TV */
  hallSyncMode     String   @default("follow_hall")
  iptvChannelId    String?
  iptvChannel      BostonTvIptvChannel? @relation(fields: [iptvChannelId], references: [id], onDelete: SetNull)
  playlistId       String?
  playlist         BostonTvPlaylist? @relation(fields: [playlistId], references: [id], onDelete: SetNull)
  scheduleTimezone String   @default("America/Sao_Paulo")
  /** Janelas: [{ "weekdays":[1-7], "start":"HH:mm", "end":"HH:mm" }] — 1=seg … 7=dom. null/vazio = sempre exibir (sem blecaute por agenda). */
  weeklySchedule   Json?
  lastSeenAt       DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([tenantId])
}

// Postagens de marketing / redes sociais — calendário inspirado no Meta Business Suite
model MarketingPost {
  id          String    @id @default(cuid())
  tenantId    String?   // null = postagem do grupo; preenchido = postagem do clube/empresa
  tenant      Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title       String?   // título curto (opcional)
  content     String    @db.Text // texto da postagem
  imageUrls   Json?     // ["url1","url2"] — imagens da mídia ou URL externa
  platforms   Json?     // ["facebook","instagram","linkedin"] — destinos planejados
  scheduledAt DateTime? // quando agendar publicação (null = rascunho)
  status      String    @default("draft") // draft | scheduled | published | failed | cancelled
  externalIds Json?     // { facebook: "xxx", instagram: "xxx" } — IDs após publicar no Meta
  publishedAt DateTime? // quando foi publicado (se status=published)
  notes       String?   @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  @@index([tenantId])
  @@index([scheduledAt])
  @@index([status])
}

// Boston City Hall — venue: espaços, reservas e pipeline comercial
model VenueSpace {
  id               String         @id @default(cuid())
  venueSlug        String         @default("boston-city-hall")
  name             String
  slug             String
  capacityStanding Int?
  capacitySeated   Int?
  sortOrder        Int            @default(0)
  active           Boolean        @default(true)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  bookings         VenueBooking[]

  @@unique([venueSlug, slug])
  @@index([venueSlug])
}

model VenueBooking {
  id             String              @id @default(cuid())
  venueSlug      String              @default("boston-city-hall")
  spaceId        String
  space          VenueSpace          @relation(fields: [spaceId], references: [id], onDelete: Restrict)
  title          String
  eventType      String?
  startAt        DateTime
  endAt          DateTime
  status         String              @default("hold")
  pipelineLeadId String?             @unique
  pipelineLead   VenuePipelineLead?  @relation(fields: [pipelineLeadId], references: [id], onDelete: SetNull)
  contactName    String?
  contactEmail   String?
  contactPhone   String?
  guestCount     Int?
  notes          String?             @db.Text
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([venueSlug, startAt])
  @@index([spaceId])
  @@index([status])
}

model VenuePipelineLead {
  id            String        @id @default(cuid())
  venueSlug     String        @default("boston-city-hall")
  contactName   String
  contactEmail  String
  contactPhone  String?
  companyName   String?
  eventType     String?
  guestCount    Int?
  preferredDate DateTime?
  message       String?       @db.Text
  stage         String        @default("lead")
  source        String        @default("manual")
  notes         String?       @db.Text
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  booking       VenueBooking?
  communicationConversations CommunicationConversation[]

  @@index([venueSlug, stage])
  @@index([createdAt])
}

// ─── Captação / Scouting ─────────────────────────────────────────────────────

/** Captador (scout) — cadastro dedicado com histórico e carteira de prospects */
model Scout {
  id                String   @id @default(cuid())
  tenantId          String
  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  technicalStaffId  String?  @unique
  technicalStaff    TechnicalStaff? @relation(fields: [technicalStaffId], references: [id], onDelete: SetNull)
  name              String
  email             String?
  phone             String?
  /** Regiões de atuação: estados, países ou zonas livres */
  regions           Json?
  /** Categorias que capta: principal, sub20, sub17… */
  categories        Json?
  /** Posições de foco: GK, CB, CM… */
  specialties       Json?
  licenseInfo       String?
  active            Boolean  @default(true)
  notes             String?  @db.Text
  /** Última posição GPS conhecida */
  lastLatitude      Float?
  lastLongitude     Float?
  lastLocationLabel String?
  lastLocationAt    DateTime?
  /** Modo campo — compartilhamento ativo de GPS */
  isTracking        Boolean  @default(false)
  trackingStartedAt DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  prospects         ScoutingProspect[]
  reports           ScoutingReport[]
  locationPings     ScoutLocationPing[]

  @@index([tenantId])
  @@index([tenantId, active])
}

/** Atleta em captação — pipeline do departamento */
model ScoutingProspect {
  id                String   @id @default(cuid())
  tenantId          String
  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  playerId          String?
  player            Player?  @relation(fields: [playerId], references: [id], onDelete: SetNull)
  scoutId           String?
  scout             Scout?   @relation(fields: [scoutId], references: [id], onDelete: SetNull)
  /** identificado | em_observacao | prioridade | tryout | negociacao | aprovado | cadastrado | recusado | arquivado */
  stage             String   @default("identificado")
  /** alta | media | baixa */
  priority          String   @default("media")
  name              String
  birthDate         String?
  nationality       String?
  position          String?
  secondaryPositions Json?
  preferredFoot     String?
  height            Int?
  weight            Int?
  currentClub       String?
  competition       String?
  /** profissional | serie_a | serie_b | estadual | base | amador | internacional */
  competitionLevel  String?
  contractSituation String?
  contractEndDate   String?
  agentName         String?
  agentPhone        String?
  agentEmail        String?
  /** jogo | indicacao | video | plataforma | torneio | rede | outro */
  source            String?
  sourceDetails     String?
  targetCategory    String?
  discoveredAt      DateTime @default(now())
  lastObservedAt    DateTime?
  observationCount  Int      @default(0)
  overallRating     Float?
  /** contratar | continuar | descartar */
  recommendation    String?
  strengths         String?  @db.Text
  weaknesses        String?  @db.Text
  risks             String?  @db.Text
  profileLinks      Json?
  notes             String?  @db.Text
  /** Aprovação do supervisor para virar atleta do clube */
  supervisorApprovedAt DateTime?
  supervisorApprovedBy String?
  supervisorNotes   String?  @db.Text
  /** pendente | em_andamento | concluido — fluxo jurídico após cadastro */
  legalStatus       String?  @default("pendente")
  /** pendente | aprovado | para_teste — encaminhamento para avaliação */
  evaluationOutcome String?  @default("pendente")
  /** Notas agregadas 0–10 (último relatório) */
  technicalRating   Float?
  tacticalRating    Float?
  physicalRating    Float?
  cognitiveRating   Float?
  /** Observação descritiva completa (perfil do observado) */
  descriptiveObservation String? @db.Text
  /** Precisa de alojamento para avaliação / try-out */
  needsLodging          Boolean?
  /** Data de apresentação no clube (quando não precisa alojar) */
  presentationDate      String?
  /** E-mail ao gerente enviado quando encaminhado como aprovado */
  managerNotifiedAt     DateTime?
  schedulerNotifiedAt DateTime?
  /// nao_agendado | agendado | faltou | compareceu | em_avaliacao | concluido
  ctScheduleStatus      String?
  ctScheduledAt         DateTime?
  ctScheduleNotes       String?  @db.Text
  ctEvaluationStartedAt DateTime?
  ctEvaluationCompletedAt DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  reports           ScoutingReport[]
  physioTryoutClearances PhysioTryoutClearance[]

  @@index([tenantId])
  @@index([tenantId, stage])
  @@index([tenantId, priority])
  @@index([scoutId])
  @@index([playerId])
}

/** Relatório de observação — padrão CBF / scout profissional */
model ScoutingReport {
  id                String   @id @default(cuid())
  tenantId          String
  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  prospectId        String
  prospect          ScoutingProspect @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  scoutId           String
  scout             Scout    @relation(fields: [scoutId], references: [id], onDelete: Restrict)
  reportDate        DateTime @default(now())
  matchName         String?
  matchDate         String?
  competition       String?
  minutesObserved   Int?
  positionPlayed    String?
  /** ao_vivo | video | dados */
  observationType   String?
  opponentStrength  String?
  /** { area: { rating, notes } } — técnica, tática, física, mental */
  technical         Json?
  tactical          Json?
  physical          Json?
  mental            Json?
  /** Médias 0–10 por dimensão */
  technicalRating   Float?
  tacticalRating    Float?
  physicalRating    Float?
  cognitiveRating   Float?
  overallRating     Float?
  /** pendente | aprovado | para_teste */
  evaluationOutcome String?  @default("pendente")
  recommendation    String
  strengths         String?  @db.Text
  weaknesses        String?  @db.Text
  risks             String?  @db.Text
  scoutNotes        String?  @db.Text
  /** GPS do local da observação */
  latitude          Float?
  longitude         Float?
  locationLabel     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([tenantId])
  @@index([prospectId])
  @@index([scoutId])
  @@index([reportDate])
}

/** Ping GPS do captador — histórico e trilha no mapa */
model ScoutLocationPing {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  scoutId     String
  scout       Scout    @relation(fields: [scoutId], references: [id], onDelete: Cascade)
  latitude    Float
  longitude   Float
  accuracy    Float?
  altitude    Float?
  heading     Float?
  speed       Float?
  label       String?
  /** tracking | checkin | report */
  source      String   @default("checkin")
  reportId    String?
  createdAt   DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([scoutId, createdAt])
}

// ─── Communication Center (hub unificado de canais) ───────────────────────────
// Channel-agnostic: WhatsApp é o 1º provedor; IG/Messenger/Email/SMS/interno depois.
// Business Unit = Tenant. CRM: vincula Customer / VenuePipelineLead existentes (sem CRM paralelo).

/// Conta de canal por unidade (WABA, página Meta, mailbox, etc.)
model CommunicationChannelAccount {
  id             String   @id @default(cuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// whatsapp | instagram | messenger | email | sms | internal
  channelType    String
  label          String
  /// ID no provedor (phone_number_id, page_id, etc.)
  externalId     String?
  /// Display (ex.: +15551234567)
  displayAddress String?
  /// Credenciais cifradas (JSON) — padrão Omie
  credentialsEnc String?  @db.Text
  credentialsIv  String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  conversations  CommunicationConversation[]

  @@unique([tenantId, channelType, externalId])
  @@index([tenantId])
  @@index([channelType, externalId])
}

/// Thread / conversa unificada
model CommunicationConversation {
  id                  String   @id @default(cuid())
  tenantId            String
  tenant              Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  channelAccountId    String?
  channelAccount      CommunicationChannelAccount? @relation(fields: [channelAccountId], references: [id], onDelete: SetNull)
  /// Denormalizado para filtros (whatsapp | …)
  channelType         String
  /// open | pending | resolved | closed
  status              String   @default("open")
  contactName         String?
  contactPhone        String?
  contactEmail        String?
  /// ID do contato no provedor (wa_id, PSID, etc.)
  externalContactId   String?
  subject             String?
  /// Enriquecimento CRM existente
  customerId          String?
  customer            Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  venuePipelineLeadId String?
  venuePipelineLead   VenuePipelineLead? @relation(fields: [venuePipelineLeadId], references: [id], onDelete: SetNull)
  /// Fallback polimórfico: employee | player | socio | prospect | supplier
  linkedEntityType    String?
  linkedEntityId      String?
  assignedToUserId    String?
  assignedToName      String?
  isFavorite          Boolean  @default(false)
  unreadCount         Int      @default(0)
  lastMessageAt       DateTime?
  lastMessagePreview  String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  messages            CommunicationMessage[]
  notes               CommunicationNote[]
  activities          CommunicationActivity[]
  tags                CommunicationConversationTag[]

  @@index([tenantId, status])
  @@index([tenantId, channelType])
  @@index([tenantId, lastMessageAt])
  @@index([tenantId, isFavorite])
  @@index([assignedToUserId])
  @@index([customerId])
  @@index([venuePipelineLeadId])
  @@index([contactPhone])
  @@index([externalContactId])
}

model CommunicationMessage {
  id             String   @id @default(cuid())
  conversationId String
  conversation   CommunicationConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  /// inbound | outbound | system
  direction      String
  /// text | image | audio | video | document | template
  messageType    String   @default("text")
  body           String?  @db.Text
  mediaUrl       String?
  mediaMimeType  String?
  externalId     String?
  /// pending | sent | delivered | read | failed
  deliveryStatus String?
  sentByUserId   String?
  sentByName     String?
  metadata       Json?
  createdAt      DateTime @default(now())

  @@index([conversationId, createdAt])
  @@index([externalId])
}

model CommunicationNote {
  id              String   @id @default(cuid())
  conversationId  String
  conversation    CommunicationConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  body            String   @db.Text
  createdByUserId String?
  createdByName   String?
  createdAt       DateTime @default(now())

  @@index([conversationId, createdAt])
}

model CommunicationTag {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name          String
  color         String?
  createdAt     DateTime @default(now())
  conversations CommunicationConversationTag[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model CommunicationConversationTag {
  conversationId String
  tagId          String
  conversation    CommunicationConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  tag            CommunicationTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([conversationId, tagId])
  @@index([tagId])
}

model CommunicationActivity {
  id             String   @id @default(cuid())
  conversationId String
  conversation   CommunicationConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  /// message | note | status_change | assignment | tag | link_crm | system
  type           String
  summary        String
  payload        Json?
  actorUserId    String?
  actorName      String?
  createdAt      DateTime @default(now())

  @@index([conversationId, createdAt])
}

model CommunicationTemplate {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  channelType  String
  name         String
  body         String   @db.Text
  /// Nome do template aprovado no Meta (WhatsApp)
  externalName String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([tenantId, channelType])
}

/// Região corporal do catálogo de fisioterapia (ombro, joelho, etc.)
model PhysioBodyRegion {
  id         String   @id // slug estável: ombro, joelho…
  namePt     String
  sortOrder  Int      @default(0)
  bilateral  Boolean  @default(true)
  diagnoses      PhysioDiagnosis[]
  treatments     PhysioTreatment[]
  sessions         PhysioSession[]
  sessionRegions   PhysioSessionRegion[]
}

/// Local(is) de dor vinculado a um atendimento (multi-lesão)
model PhysioSessionRegion {
  id          String   @id @default(cuid())
  sessionId   String
  session     PhysioSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  regionId    String
  region      PhysioBodyRegion @relation(fields: [regionId], references: [id])
  side        String?
  bodyMapView String?
  bodyMapX    Float?
  bodyMapY    Float?
  sortOrder   Int      @default(0)
  @@index([sessionId])
  @@index([regionId])
}

/// Diagnóstico vinculado a um atendimento (multi-lesão)
model PhysioSessionDiagnosis {
  id             String   @id @default(cuid())
  sessionId      String
  session        PhysioSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  regionId       String?
  diagnosisId    String?
  diagnosis      PhysioDiagnosis? @relation(fields: [diagnosisId], references: [id], onDelete: SetNull)
  diagnosisLabel String?
  sortOrder      Int      @default(0)
  @@index([sessionId])
}

/// Tratamento vinculado a um atendimento (multi-procedimento)
model PhysioSessionTreatment {
  id             String   @id @default(cuid())
  sessionId      String
  session        PhysioSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  treatmentId    String?
  treatment      PhysioTreatment? @relation(fields: [treatmentId], references: [id], onDelete: SetNull)
  treatmentLabel String?
  sortOrder      Int      @default(0)
  @@index([sessionId])
}

/// Recovery pós-jogo em grupo (atletas que jogaram)
model PhysioGroupSession {
  id              String   @id @default(cuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category        String
  sessionDate     String   // YYYY-MM-DD
  description     String?  @db.Text
  staffId         String?
  staffName       String?
  location        String?
  /// [{ playerId, playerName, present, notes? }]
  attendance      Json
  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  @@index([tenantId, sessionDate])
  @@index([tenantId, category])
}

/// Atendimento fisioterapêutico em dia de jogo (por fase e atleta)
model PhysioGameAttendance {
  id                String   @id @default(cuid())
  tenantId          String
  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  playerId          String
  player            Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  category          String?
  gameDate          String   // YYYY-MM-DD
  /// concentracao | pre_jogo | primeiro_tempo | intervalo | segundo_tempo | pos_jogo
  phase             String
  /// tratamento | preparo_preventivo
  careCategory      String
  /// botinha | bandagem_elastica | bandagem_estabilizacao | outro
  procedureKey      String
  procedureLabel    String?
  /// [{ procedureKey, procedureLabel? }]
  procedures        Json?
  /// estabilizar | proteger | reforcar_musculatura | limitar_movimento
  treatmentReason   String?
  /// tornozelo | joelho | adutor | quadril | outro
  bodyLocation      String
  bodyLocationLabel String?
  /// [{ bodyLocation, bodyLocationLabel? }]
  bodyLocations     Json?
  notes             String?  @db.Text
  staffId           String?
  staffName         String?
  createdByUserId   String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  @@index([tenantId, gameDate])
  @@index([playerId, gameDate])
  @@index([tenantId, category, gameDate])
}

/// Avaliação fisioterapêutica do atleta (pré/inter/pós temporada, desligamento)
model PhysioPlayerEvaluation {
  id                String   @id @default(cuid())
  tenantId          String
  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  playerId          String
  player            Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  category          String?
  /// pre_temporada | inter_temporada | pos_temporada | desligamento
  context           String
  /// Nota geral da avaliação (0–10)
  rating            Float?
  finalObservations String?  @db.Text
  /// aprovado | reprovado
  outcome           String?
  /// Anexos (ex.: PDF Kinology) [{ name, url, key, mimeType }]
  attachments       Json?
  evaluatedAt       DateTime @default(now())
  staffId           String?
  staffName         String?
  createdByUserId   String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  tests             PhysioPlayerEvaluationTest[]
  @@index([tenantId, context])
  @@index([playerId, evaluatedAt])
}

model PhysioPlayerEvaluationTest {
  id                String   @id @default(cuid())
  evaluationId      String
  evaluation        PhysioPlayerEvaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  testType          String
  testTypeLabel     String?
  bodyLocation      String
  bodyLocationLabel String?
  /// y_balance | t_test | stop_down | hop_test | perimetria | agachamento_bastao | forca_kinology
  protocol          String?
  payload           Json?
  /// aprovado | aceitavel | reprovado | medio | ruim | bom | razoavel
  classification    String?
  score             String?
  notes             String?  @db.Text
  sortOrder         Int      @default(0)
  @@index([evaluationId])
}

/// Liberação fisioterapêutica obrigatória antes de avaliação em campo (try-out / CT)
model PhysioTryoutClearance {
  id                   String   @id @default(cuid())
  tenantId             String
  tenant               Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  prospectId           String
  prospect             ScoutingProspect @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  playerId             String?
  player               Player?  @relation(fields: [playerId], references: [id], onDelete: SetNull)
  prospectName         String?
  targetCategory       String?
  staffId              String?
  staffName            String?
  injuryHistory        String?  @db.Text
  /// Testes bilaterais + respostas/outcomes por lado
  bilateralTests       Json
  manualStrengthTest   String?  @db.Text
  observations         String?  @db.Text
  /// aprovado | reprovado
  outcome              String
  evaluatedAt          DateTime @default(now())
  supervisorNotifiedAt DateTime?
  managerNotifiedAt    DateTime?
  emailNotifyError     String?
  createdByUserId      String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  @@index([tenantId, prospectId])
  @@index([playerId])
  @@index([prospectId, evaluatedAt])
}

/// Diagnóstico clínico categorizado por região (seed + cadastro dinâmico pelo fisio)
model PhysioDiagnosis {
  id              String   @id @default(cuid())
  regionId        String
  region          PhysioBodyRegion @relation(fields: [regionId], references: [id], onDelete: Cascade)
  name            String
  isSystem        Boolean  @default(false)
  active          Boolean  @default(true)
  createdByUserId String?
  createdAt       DateTime @default(now())
  sessions         PhysioSession[]
  sessionDiagnoses PhysioSessionDiagnosis[]
  @@unique([regionId, name])
  @@index([regionId, active])
}

/// Tratamento / procedimento / equipamento (cadastro dinâmico)
model PhysioTreatment {
  id              String   @id @default(cuid())
  name            String
  regionId        String?
  region          PhysioBodyRegion? @relation(fields: [regionId], references: [id], onDelete: SetNull)
  equipment       String?
  isSystem        Boolean  @default(false)
  active          Boolean  @default(true)
  createdByUserId String?
  createdAt       DateTime @default(now())
  sessions        PhysioSession[]
  sessionTreatments PhysioSessionTreatment[]
  @@index([regionId, active])
  @@index([active])
}

/// Atendimento fisioterapêutico do atleta (ciclo até alta)
model PhysioSession {
  id               String   @id @default(cuid())
  tenantId         String
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  playerId         String
  player           Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  category         String?
  regionId         String
  region           PhysioBodyRegion @relation(fields: [regionId], references: [id])
  side             String?  // E | D | bilateral
  bodyMapView      String?  // front | back
  bodyMapX         Float?
  bodyMapY         Float?
  symptoms         String?  @db.Text
  painScore        Int?
  diagnosisId      String?
  diagnosis        PhysioDiagnosis? @relation(fields: [diagnosisId], references: [id], onDelete: SetNull)
  diagnosisLabel   String?
  treatmentId      String?
  treatment        PhysioTreatment? @relation(fields: [treatmentId], references: [id], onDelete: SetNull)
  treatmentLabel   String?
  treatmentNotes   String?  @db.Text
  estimatedDays    Int?
  estimatedEndDate DateTime?
  startedAt        DateTime @default(now())
  endedAt          DateTime?
  status           String   @default("active") // active | completed | cancelled
  /// Desfecho do atendimento: alta | em_tratamento | nao_apto | encaminhado_transicao
  disposition      String?
  /// Atleta segue programa de transição (fisiologia + preparação + fisio)
  needsTransition    Boolean  @default(false)
  transitionStartedAt DateTime?
  transitionCompletedAt DateTime?
  staffId          String?
  staffName        String?
  attachments      Json?
  evolutionNotes   Json?
  createdByUserId  String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  sessionRegions   PhysioSessionRegion[]
  sessionDiagnoses PhysioSessionDiagnosis[]
  sessionTreatments PhysioSessionTreatment[]
  transitionEntries PhysioTransitionEntry[]
  transitionProgram PhysioTransitionProgram? @relation("PhysioTransitionOrigin")
  @@index([tenantId, status])
  @@index([playerId, status])
  @@index([regionId])
  @@index([startedAt])
}

/// Programa de transição (Performance/Fisiologia) após encerramento do tratamento fisioterápico
model PhysioTransitionProgram {
  id               String   @id @default(cuid())
  tenantId         String
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  playerId         String
  player           Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  originSessionId  String   @unique
  originSession    PhysioSession @relation("PhysioTransitionOrigin", fields: [originSessionId], references: [id], onDelete: Restrict)
  status           String   @default("active") // active | completed | cancelled
  startedAt        DateTime @default(now())
  completedAt      DateTime?
  createdByUserId  String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  entries          PhysioTransitionEntry[]
  @@index([tenantId, status])
  @@index([playerId, status])
}

/// Sessão de transição do retorno ao treino (vinculada ao programa de transição)
model PhysioTransitionEntry {
  id               String   @id @default(cuid())
  programId        String
  program          PhysioTransitionProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  /// Sessão fisioterápica de origem (legado / referência histórica)
  sessionId        String
  session          PhysioSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionDate      String   // YYYY-MM-DD
  workType         String
  workTypeLabel    String?
  startTime        String   // HH:mm
  endTime          String   // HH:mm
  durationMinutes  Int
  objective        String?  @db.Text
  activities       String?  @db.Text
  evolutionNote    String?  @db.Text
  stillFeelsPain   Boolean  @default(false)
  evolutionScore   Int?     // 0–10
  needsNewSession  Boolean  @default(true)
  staffId          String?
  staffName        String?
  createdByUserId  String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  @@index([programId, sessionDate])
  @@index([sessionId, sessionDate])
}

