// Prisma 7: URL do banco fica em prisma.config.ts
datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model TenantKind {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenants   Tenant[]
}

model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  kindId    String
  kind      TenantKind @relation(fields: [kindId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
