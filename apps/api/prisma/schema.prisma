  category      LogisticsClothingCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  groupId       String?
  group         LogisticsClothingGroup?    @relation(fields: [groupId], references: [id], onDelete: SetNull)
  uniformTypeId String?
  uniformType   LogisticsUniformType?      @relation(fields: [uniformTypeId], references: [id], onDelete: SetNull)
