{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "entryFile": "main",
  "compilerOptions": {
    "deleteOutDir": true,
    "tsConfigPath": "tsconfig.prod.json",
    "assets": [
      {
        "include": "desenvolvimento/content/manifests/**/*.json",
        "outDir": "dist"
      },
      {
        "include": "public-domain/cloudfront-viewer-request.template.js",
        "outDir": "dist",
        "watchAssets": true
      }
    ]
  }
}
