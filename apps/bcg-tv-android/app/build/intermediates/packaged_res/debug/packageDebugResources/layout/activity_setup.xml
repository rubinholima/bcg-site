<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_setup_gradient"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="28dp">

        <ImageView
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:contentDescription="@null"
            android:src="@drawable/cup360_logo" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/setup_title"
            android:textColor="#FCD34D"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/setup_subtitle"
            android:textColor="#A1A1AA"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_setup_card"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/setup_screen_label"
                android:textColor="#E4E4E7"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/screenSpinner"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_spinner"
                android:padding="12dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_setup_card"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/setup_playlist_label"
                android:textColor="#E4E4E7"
                android:textSize="14sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/syncModeGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">

                <RadioButton
                    android:id="@+id/syncFollowHall"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:paddingVertical="6dp"
                    android:text="@string/setup_sync_hall"
                    android:textColor="#D4D4D8"
                    android:textSize="15sp" />

                <RadioButton
                    android:id="@+id/syncIndependent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="6dp"
                    android:text="@string/setup_sync_independent"
                    android:textColor="#D4D4D8"
                    android:textSize="15sp" />
            </RadioGroup>

            <TextView
                android:id="@+id/hallChannelHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/setup_loading_playlists"
                android:textColor="#71717A"
                android:textSize="13sp" />

            <Spinner
                android:id="@+id/playlistSpinner"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_spinner"
                android:enabled="false"
                android:padding="12dp"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_setup_card"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/setup_engine"
                android:textColor="#E4E4E7"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/engineSpinner"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_spinner"
                android:padding="12dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/ndiSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_setup_card"
            android:orientation="vertical"
            android:padding="20dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/setup_ndi_label"
                android:textColor="#E4E4E7"
                android:textSize="14sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/ndiSourceModeGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">

                <RadioButton
                    android:id="@+id/ndiFromPlaylist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:paddingVertical="6dp"
                    android:text="@string/setup_ndi_from_playlist"
                    android:textColor="#D4D4D8"
                    android:textSize="15sp" />

                <RadioButton
                    android:id="@+id/ndiFromNetwork"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="6dp"
                    android:text="@string/setup_ndi_from_network"
                    android:textColor="#D4D4D8"
                    android:textSize="15sp" />
            </RadioGroup>

            <Button
                android:id="@+id/ndiSearchButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_menu_button"
                android:text="@string/setup_ndi_search"
                android:textAllCaps="false"
                android:textColor="#FCD34D"
                android:textSize="15sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/ndiDiscoveryStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="#71717A"
                android:textSize="13sp"
                android:visibility="gone" />

            <Spinner
                android:id="@+id/ndiSourceSpinner"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_spinner"
                android:padding="12dp"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/setupStatusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:textColor="#71717A"
            android:textSize="13sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/startButton"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_btn_primary"
            android:text="@string/setup_confirm"
            android:textAllCaps="false"
            android:textColor="#18181B"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>
</ScrollView>
